    { loading = "Carregando", done = "Concluído",
      stages = { "Iniciando núcleo", "Carregando módulos", "Construindo interface", "Finalizando" } },
}

local function runLoading(gui)
    local total = Config.LoadTime

    local overlay = create("Frame", {
        Name = "Loading", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.Black,
        BorderSizePixel = 0, ZIndex = 10, Parent = gui,
    })
    create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Theme.Accent:Lerp(BLACK, 0.82)),
            ColorSequenceKeypoint.new(0.5, Theme.Black),
            ColorSequenceKeypoint.new(1, Theme.Accent:Lerp(BLACK, 0.88)),
        }),
        Rotation = 45, Parent = overlay,
    })

    local logoHolder = create("Frame", {
        Size = UDim2.fromOffset(240, 232), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, -70), BackgroundTransparency = 1, ZIndex = 11, Parent = overlay,
    })
    local scale = create("UIScale", { Scale = 0.6, Parent = logoHolder })
    local ghostA = createLogo(logoHolder, UDim2.fromScale(1, 1), Theme.Accent, 11)
    local ghostB = createLogo(logoHolder, UDim2.fromScale(1, 1), Color3.fromRGB(90, 200, 255), 11)
    local main   = createLogo(logoHolder, UDim2.fromScale(1, 1), nil, 12)
    local function setGhost(g, t)
        if g:IsA("ImageLabel") then g.ImageTransparency = t else g.TextTransparency = t end
    end
    setGhost(ghostA, 1); setGhost(ghostB, 1)
    tween(scale, { Scale = 1 }, 0.9, Enum.EasingStyle.Back)

    local nameG = createGlitchName(overlay, 22, UDim2.new(0.5, 0, 0.5, 58), Vector2.new(0.5, 0), 11)

    local loadText = create("TextLabel", {
        Size = UDim2.fromOffset(420, 30), AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0.5, 96), BackgroundTransparency = 1, Text = "",
        TextColor3 = Theme.Text, Font = Theme.FontBold, TextSize = 20, ZIndex = 11, Parent = overlay,
    })
    local stageText = create("TextLabel", {
        Size = UDim2.fromOffset(420, 18), AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0.5, 126), BackgroundTransparency = 1, Text = "",
        TextColor3 = Theme.SubText, Font = Theme.Font, TextSize = 13, ZIndex = 11, Parent = overlay,
    })

    local track = create("Frame", {
        Size = UDim2.fromOffset(340, 6), AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0.5, 158), BackgroundColor3 = Theme.Off,
        BorderSizePixel = 0, ZIndex = 11, Parent = overlay,
    }, { corner(3) })
    local fill = create("Frame", {
        Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 12, Parent = track,
    }, { corner(3), create("UIGradient", { Color = ColorSequence.new(Theme.AccentDark, Theme.AccentLite) }) })
    local glow = create("Frame", {
        Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Theme.AccentLite, ZIndex = 13, Parent = track,
    }, { corner(7) })

    local percent = create("TextLabel", {
        Size = UDim2.fromOffset(340, 18), AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0.5, 172), BackgroundTransparency = 1, Text = "0%",
        TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Right,
        Font = Theme.FontBold, TextSize = 12, ZIndex = 11, Parent = overlay,
    })

    local dots = {}
    local dotRow = create("Frame", {
        Size = UDim2.fromOffset(120, 14), AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0.5, 198), BackgroundTransparency = 1, ZIndex = 11, Parent = overlay,
    }, { create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 14),
    }) })
    for i, name in ipairs({ "日本語", "EN", "PT" }) do
        dots[i] = create("TextLabel", {
            Size = UDim2.fromOffset(28, 14), BackgroundTransparency = 1, Text = name,
            TextColor3 = Theme.Off, Font = Theme.FontBold, TextSize = 10, ZIndex = 11,
            LayoutOrder = i, Parent = dotRow,
        })
    end

    local running = true
    startNameGlitch(nameG, function() return running end)
    -- glitch rápido
    task.spawn(function()
        local layers = { ghostA, ghostB }
        while running do
            task.wait(math.random(2, 7) / 10)
            if not running then break end
            for _ = 1, math.random(5, 9) do
                for i, g in ipairs(layers) do
                    g.Position = UDim2.new(0.5, math.random(-9, 9) * (i == 1 and 1 or -1), 0.5, math.random(-3, 3))
                    setGhost(g, 0.35)
                end
                main.Position = UDim2.new(0.5, math.random(-4, 4), 0.5, 0)
                task.wait(0.025)
            end
            for _, g in ipairs(layers) do
                g.Position = UDim2.fromScale(0.5, 0.5)
                setGhost(g, 1)
            end
            main.Position = UDim2.fromScale(0.5, 0.5)
        end
    end)
    -- respiração
    task.spawn(function()
        task.wait(1)
        while running do
            tween(scale, { Scale = 1.04 }, 1.2, Enum.EasingStyle.Sine)
            task.wait(1.2)
            tween(scale, { Scale = 0.98 }, 1.2, Enum.EasingStyle.Sine)
            task.wait(1.2)
        end
    end)

    local langIndex, currentStage = 0, 1
    local function stageFor(a) return a < 0.25 and 1 or a < 0.55 and 2 or a < 0.85 and 3 or 4 end
    local function applyLang(index, alpha, instant)
        local lang = LANGS[index]
        local newText, newStage = lang.loading .. "...", lang.stages[stageFor(alpha)]
        for i, d in ipairs(dots) do
            tween(d, { TextColor3 = (i == index) and Theme.AccentLite or Theme.Off })
        end
        if instant then
            loadText.Text, stageText.Text = newText, newStage
            return
        end
        tween(loadText, { TextTransparency = 1, Position = UDim2.new(0.5, 0, 0.5, 90) }, 0.1)
        tween(stageText, { TextTransparency = 1 }, 0.1)
        task.delay(0.1, function()
            loadText.Text, stageText.Text = newText, newStage
            loadText.Position = UDim2.new(0.5, 0, 0.5, 102)
            tween(loadText, { TextTransparency = 0, Position = UDim2.new(0.5, 0, 0.5, 96) }, 0.15)
            tween(stageText, { TextTransparency = 0 }, 0.15)
        end)
    end

    local startClock, lastSwitch = os.clock(), -math.huge
    while true do
        local elapsed = os.clock() - startClock
        local alpha = math.clamp(elapsed / total, 0, 1)
        fill.Size = UDim2.fromScale(alpha, 1)
        glow.Position = UDim2.new(alpha, 0, 0.5, 0)
        percent.Text = string.format("%d%%", math.floor(alpha * 100))

        if elapsed - lastSwitch >= Config.LangSwitch then
            lastSwitch = elapsed
            langIndex = langIndex % #LANGS + 1
            applyLang(langIndex, alpha, langIndex == 1 and elapsed < 0.1)
        else
            local s = stageFor(alpha)
            if s ~= currentStage then
                currentStage = s
                stageText.Text = LANGS[langIndex].stages[s]
            end
        end
        if alpha >= 1 then break end
        RunService.Heartbeat:Wait()
    end

    percent.Text = "100%"
    loadText.Text = LANGS[langIndex].done .. "!"
    stageText.Text = ""
    task.wait(0.6)
    running = false

    for _, d in ipairs(overlay:GetDescendants()) do
        if d:IsA("TextLabel") then tween(d, { TextTransparency = 1 }, 0.5) end
        if d:IsA("ImageLabel") then tween(d, { ImageTransparency = 1 }, 0.5) end
        if d:IsA("Frame") then tween(d, { BackgroundTransparency = 1 }, 0.5) end
    end
    tween(scale, { Scale = 1.25 }, 0.5)
    tween(overlay, { BackgroundTransparency = 1 }, 0.6)
    task.wait(0.65)
    overlay:Destroy()
end

