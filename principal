----------------------------------------------------------------------
-- MISSÃO (leitura da interface do jogo)
-- PlayerGui.Interfaces.Screen.Quest  ("Collect ... (1/5)")
----------------------------------------------------------------------
local QUEST_PATH = { "Interfaces", "Screen", "Quest" }

-- true se o elemento está MESMO visível na tela: Visible/Enabled, com tamanho, dentro da tela
-- e sem transparência total. Evita ler texto "velho" de uma interface que só foi escondida ou movida.
local function isShown(obj)
    if hiddenReason(obj) then return false end
    if not obj:IsA("GuiObject") then return true end
    if obj.AbsoluteSize.X <= 0 or obj.AbsoluteSize.Y <= 0 then return false end
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    local c = obj.AbsolutePosition + obj.AbsoluteSize / 2
    if c.X < -20 or c.Y < -20 or c.X > vp.X + 20 or c.Y > vp.Y + 20 then return false end
    local p = obj
    while p and not p:IsA("LayerCollector") do
        if p:IsA("CanvasGroup") and p.GroupTransparency >= 0.99 then return false end
        p = p.Parent
    end
    if obj:IsA("TextLabel") and obj.TextTransparency >= 0.99 then return false end
    return true
end

-- botão Cancel da missão: PlayerGui.Interfaces.Screen.Quest.Current.Options.Cancel
local function getCancelButton()
    local pg = Players.LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    return resolvePath(pg, { "Interfaces", "Screen", "Quest", "Current", "Options", "Cancel" }, "Cancel")
end

-- Estado da missão controlado pelo PRÓPRIO script.
-- active = missão aceita agora; kills = frutas que ESTE script coletou nela.
local QuestState = { active = false, kills = 0, total = 5, text = nil, npcDone = false, kind = nil }  -- kind: "zack" | "mari"

-- devolve (atual, total, texto) lido da interface, ou nil se o texto não está visível na tela
local function getQuestProgress()
    local pg = Players.LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local quest = resolvePath(pg, QUEST_PATH, "Quest")
    if not quest then return nil end

    local candidates = {}
    local current = quest:FindFirstChild("Current")
    local exact = current and current:FindFirstChild("Description")
    if exact then table.insert(candidates, exact) end
    for _, d in ipairs(quest:GetDescendants()) do
        if d:IsA("TextLabel") and d ~= exact then table.insert(candidates, d) end
    end

    for _, label in ipairs(candidates) do
        if label:IsA("TextLabel") then
            local cur, total = label.Text:match("%((%d+)%s*/%s*(%d+)%)")
            if cur and isShown(label) then
                log("Quest", string.format("'%s' -> %s/%s", label.Text, cur, total))
                return tonumber(cur), tonumber(total), label.Text
            end
        end
    end
    return nil
end

-- a missão está na tela? (botão Cancel visível OU texto de progresso visível)
local function questUiShown()
    local btn = getCancelButton()
    if btn and isShown(btn) then return true end
    return getQuestProgress() ~= nil
end

-- cancela qualquer missão em andamento (aperta Cancel) e espera ela sumir,
-- para começar do zero: falar com a Mari, aceitar e coletar
local function cancelQuest(alive)
    local btn = getCancelButton()
    if not btn then return false end

    -- a interface pode estar animando: dá até 1s para o botão ficar visível
    local waited = 0
    while waited < 1 and alive() and not isShown(btn) do
        task.wait(0.05)
        waited += 0.05
    end
    if not isShown(btn) then
        log("Cancel", "botão Cancel não está visível: nenhuma missão ativa, nada para cancelar")
        return true
    end

    log("Cancel", "missão ativa, apertando Cancel: " .. btn:GetFullName())
    pressButton(btn)

    -- espera a missão sumir (botão some ou o texto de progresso some)
    waited = 0
    while waited < 2.5 and alive() do
        if not isShown(btn) or not getQuestProgress() then
            log("Cancel", "missão cancelada")
            task.wait(0.2)
            return true
        end
        task.wait(0.1)
        waited += 0.1
    end
    log("Cancel", "apertei Cancel mas a missão continua na tela (o jogo pode pedir confirmação?)", true)
    return false
end

----------------------------------------------------------------------
-- AUTO ACEITAR  (2ª forma de aceitar a missão)
-- A 1ª missão é aceita falando com a Mari. Depois que ela termina, as próximas são aceitas
-- direto no botão "Aceitar" da janela "Repetir Missão", SEM voltar na Mari:
--   PlayerGui.Interfaces.Screen["Repeat Quest"].Background.Frame.Buttons.Accept
-- Esse botão fica Visible = true quando a missão termina; o script confere a CADA FRAME
-- e aperta no mesmo frame em que ele aparece.
----------------------------------------------------------------------
local AutoAccept = {
    Enabled = true,
    Timeout = 3,   -- segundos esperando o botão aparecer antes de voltar para a Mari
}

local function getRepeatAcceptButton()
    local pg = Players.LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    return resolvePath(pg, { "Interfaces", "Screen", "Repeat Quest", "Background", "Frame", "Buttons", "Accept" }, "Repeat")
end

-- o botão "Aceitar" está visível agora?
local function repeatAcceptShown()
    local btn = getRepeatAcceptButton()
    return btn ~= nil and isShown(btn), btn
end

-- espera o botão "Aceitar" aparecer (checando a cada frame) e aperta na hora.
-- Devolve true se a missão foi aceita.
local function acceptRepeatQuest(alive, timeout)
    local started = os.clock()
    local btn

    -- 1) espera ficar visível (a cada frame = instantâneo)
    while alive() do
        local shown, b = repeatAcceptShown()
        if shown then btn = b break end
        if os.clock() - started >= timeout then
            log("Repeat", string.format("botão Aceitar não apareceu em %ds", timeout), true)
            return false
        end
        RunService.Heartbeat:Wait()
    end
    if not btn then return false end

    -- 2) aperta no mesmo frame; só repete (a cada 0.3s) se ele continuar na tela
    log("Repeat", "botão Aceitar visível, apertando: " .. btn:GetFullName())
    pressButton(btn)
    local lastPress, presses, t0 = os.clock(), 1, os.clock()
    while alive() and isShown(btn) and os.clock() - t0 < 2 do
        if presses < 4 and os.clock() - lastPress >= 0.15 then
            pressButton(btn)
            lastPress = os.clock()
            presses += 1
        end
        RunService.Heartbeat:Wait()
    end
    if isShown(btn) then
        log("Repeat", "apertei Aceitar mas a janela continua na tela", true)
        return false
    end

    -- 3) a janela fechou = missão aceita. Espera (até 1s) o contador novo (x/y, com x < y) aparecer
    t0 = os.clock()
    while alive() and os.clock() - t0 < 1 do
        local cur, total = getQuestProgress()
        if cur and total and cur < total then break end
        RunService.Heartbeat:Wait()
    end
    log("Repeat", "missão repetida aceita")
    return true
end

-- aceita pelo botão e já deixa o estado pronto para coletar as frutas
local function startQuestViaRepeat(alive)
    if not acceptRepeatQuest(alive, AutoAccept.Timeout) then return false end
    local _, total, text = getQuestProgress()
    QuestState.active = true
    QuestState.kills = 0
    QuestState.total = total or QuestState.total or 5
    QuestState.text = text
    return true
end

----------------------------------------------------------------------
-- FRUTAS
-- Lista todo ProximityPrompt dentro de Workspace.World.Islands.*.FruitsSpawns
-- (Orange e qualquer outra fruta que existir), da mais próxima para a mais longe.
----------------------------------------------------------------------
local function collectFruits()
    local list = {}
    local islands = resolvePath(workspace, FruitFarm.Path, "Fruit")
    if not islands then return list end

    for _, island in ipairs(islands:GetChildren()) do
        local spawns = island:FindFirstChild("FruitsSpawns")
        if spawns then
            for _, d in ipairs(spawns:GetDescendants()) do
                if d:IsA("ProximityPrompt") and d.Enabled and d.Parent then
                    local pos = locationPosition(d.Parent)
                    if pos then table.insert(list, { prompt = d, pos = pos }) end
                end
            end
        end
    end

    local char = Players.LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local from = hrp.Position
        table.sort(list, function(a, b)
            return (a.pos - from).Magnitude < (b.pos - from).Magnitude
        end)
    end

    log("Fruit", string.format("%d frutas com prompt em %s", #list, islands:GetFullName()))
    return list
end

-- com a quest ativa: teleporta para CADA fruta e coleta na hora (sem cooldown, sem segurar E).
-- CONTAGEM: a fonte da verdade é o contador da interface do jogo "(x/y)". Como reserva, o script
-- confere TODAS as frutas que ele disparou (pending) e conta cada uma que sumiu/desativou, mesmo
-- que isso demore mais que a espera depois do disparo (o servidor pode demorar a remover a fruta).
-- Termina quando: a contagem chega na meta, ou a missão some da tela por 3s.
local function collectFruitsForQuest(alive, status)
    local fired, goneSince = 0, nil
    local pending = {}   -- prompts disparados que ainda não foram contados
    local ownCount = 0   -- contagem própria (reserva)
    QuestState.kills = 0

    -- recontagem: confere os prompts pendentes e atualiza QuestState.kills
    local function sync()
        for i = #pending, 1, -1 do
            local p = pending[i]
            if not p.Parent or not p.Enabled or not p:IsDescendantOf(workspace) then
                ownCount += 1
                table.remove(pending, i)
            end
        end
        local cur, total, text = getQuestProgress()
        if total and total > 0 then QuestState.total = total end
        if text then QuestState.text = text end
        -- interface visível e já coletamos algo: ela manda; senão usa a contagem própria
        if cur and fired > 0 then
            QuestState.kills = math.max(cur, 0)
        else
            QuestState.kills = ownCount
        end
        return cur, total
    end

    while alive() do
        local cur, total = sync()

        -- terminou?
        if QuestState.kills >= QuestState.total then
            log("Quest", string.format("meta atingida: %d/%d", QuestState.kills, QuestState.total))
            return true
        end
        -- a janela "Repetir Missão" apareceu: a missão acabou, devolve na hora para aceitar
        if AutoAccept.Enabled and QuestState.npcDone and repeatAcceptShown() then
            log("Quest", "janela Repetir Missão apareceu")
            return true
        end
        if questUiShown() then
            goneSince = nil
        else
            goneSince = goneSince or os.clock()
            if os.clock() - goneSince >= 3 then
                log("Quest", "missão sumiu da tela, considerando encerrada")
                return true
            end
        end

        local fruits = collectFruits()
        if #fruits == 0 then
            status("No fruit found")
            task.wait(0.5)
        else
            for _, f in ipairs(fruits) do
                if not alive() then return end
                -- a fruta pode ter sumido (outro jogador pegou / despawn) desde que a lista foi montada
                if f.prompt.Parent and f.prompt.Enabled then
                    local pos = locationPosition(f.prompt.Parent) or f.pos
                    if teleportTo(pos, FruitFarm.Height) then
                        if FruitFarm.Wait > 0 then task.wait(FruitFarm.Wait) end
                        firePrompt(f.prompt)
                        fired += 1
                        table.insert(pending, f.prompt)
                        if FruitFarm.Wait > 0 then task.wait(FruitFarm.Wait) end

                        sync()
                        status(T("Collecting fruits") .. ": " .. QuestState.kills .. "/" .. QuestState.total)
                        if QuestState.kills >= QuestState.total then break end
                        if AutoAccept.Enabled and QuestState.npcDone and repeatAcceptShown() then
                            log("Quest", "janela Repetir Missão apareceu")
                            return true
                        end
                    end
                end
            end
        end
        task.wait() -- 1 frame, só para nunca travar o jogo
    end
end

----------------------------------------------------------------------
-- QUEST DE COMIDA (níveis 110-250): coleta cada comida e entrega na mesa
-- correspondente ao texto FoodName do overhead. Os prompts são acionados sem
-- espera artificial; o script só aguarda se o prompt da mesa ainda não estiver ativo.
----------------------------------------------------------------------
local processFoodQuest

local function compactName(value)
    return tostring(value or ""):lower():gsub("%s+", ""):gsub("[^%w]", "")
end

local function foodPromptName(prompt, foodsRoot)
    local names = { prompt.ObjectText, prompt.ActionText }
    local node = prompt.Parent
    while node and node ~= foodsRoot do
        table.insert(names, node.Name)
        node = node.Parent
    end
    return names
end

local function foodTableLabel(tableModel)
    if not tableModel then return nil end
    for _, d in ipairs(tableModel:GetDescendants()) do
        if d.Name == "FoodName" and (d:IsA("TextLabel") or d:IsA("TextButton")) then
            return d.Text
        end
    end
    return nil
end

local function numberedTable(tablesRoot, index)
    return tablesRoot:FindFirstChild("Table " .. index) or tablesRoot:FindFirstChild("Table" .. index)
end

local function findFoodTable(foodNames, tablesRoot)
    for i = 1, 4 do
        local tableModel = numberedTable(tablesRoot, i)
        local label = tableModel and foodTableLabel(tableModel)
        local key = compactName(label)
        if key ~= "" then
            -- Primeiro tenta igualdade exata para evitar escolher uma mesa parecida.
            for _, candidate in ipairs(foodNames) do
                local name = compactName(candidate)
                if name ~= "" and name == key then return i, candidate, label end
            end
            -- Alguns nomes do prompt incluem texto extra; aceita correspondência parcial como reserva.
            for _, candidate in ipairs(foodNames) do
                local name = compactName(candidate)
                if name ~= "" and (name:find(key, 1, true) or key:find(name, 1, true)) then
                    return i, candidate, label
                end
            end
        end
    end
    return nil
end

local function foodQuestTablesModel()
    local world = workspace:FindFirstChild("World")
    local islands = world and world:FindFirstChild("Islands")
    if not islands then return nil end

    -- Procura Quest De Comida nas ilhas; aceita Mesas direto ou dentro de Model.
    for _, island in ipairs(islands:GetChildren()) do
        local quest = island:FindFirstChild("Quest De Comida")
        if not quest then
            for _, d in ipairs(island:GetDescendants()) do
                if d.Name == "Quest De Comida" then quest = d break end
            end
        end
        if quest then
            local mesas = quest:FindFirstChild("Mesas")
                or (quest:FindFirstChild("Model") and quest.Model:FindFirstChild("Mesas"))
            if not mesas then
                for _, d in ipairs(quest:GetDescendants()) do
                    if d.Name == "Mesas" then mesas = d break end
                end
            end
            if mesas then return mesas end
        end
    end
    return nil
end

local function tablePrompt(tablesRoot, index)
    local mesasModel = foodQuestTablesModel()
    local numbered = mesasModel and mesasModel:FindFirstChild(tostring(index))
    if numbered then
        if numbered:IsA("ProximityPrompt") then return numbered, numbered.Parent end
        for _, d in ipairs(numbered:GetDescendants()) do
            if d:IsA("ProximityPrompt") then
                pcall(function()
                    d.HoldDuration = 0
                    d.RequiresLineOfSight = false
                    d.MaxActivationDistance = math.max(d.MaxActivationDistance, 40)
                end)
                return d, numbered
            end
        end
    end

    -- Reserva para a hierarquia Workspace.Tables.Mesas.1..4.
    local mesas = tablesRoot:FindFirstChild("Mesas")
    local target = mesas and (mesas:FindFirstChild(tostring(index)) or mesas:FindFirstChild("Table" .. index))
    if not target then return nil, nil end
    if target:IsA("ProximityPrompt") then return target, target.Parent end
    for _, d in ipairs(target:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            pcall(function() d.HoldDuration = 0 end)
            return d, target
        end
    end
    return nil, target
end

-- Zera configurações numéricas de cooldown nos quatro Attachments e prompts locais.
local function makeFoodTablesInstant(index)
    local root = foodQuestTablesModel()
    if not root then
        log("FoodCooldown", "modelo Mesas não encontrado dentro de Quest De Comida", true)
        return
    end
    local first, last = index or 1, index or 4
    for i = first, last do
        local attachment = root:FindFirstChild(tostring(i))
        if attachment and attachment:IsA("Attachment") then
            local objects = { attachment }
            for _, d in ipairs(attachment:GetDescendants()) do table.insert(objects, d) end
            for _, obj in ipairs(objects) do
                if obj:IsA("ProximityPrompt") then
                    pcall(function()
                        obj.HoldDuration = 0
                        obj.RequiresLineOfSight = false
                        obj.MaxActivationDistance = math.max(obj.MaxActivationDistance, 40)
                    end)
                end
                if obj:IsA("ValueBase") and type(obj.Value) == "number" then
                    local key = obj.Name:lower()
                    if key:find("cooldown", 1, true) or key == "cd" or key:find("delay", 1, true)
                        or key:find("time", 1, true) or key:find("duration", 1, true) or key:find("hold", 1, true) then
                        pcall(function() obj.Value = 0 end)
                    end
                end
                for key, value in pairs(obj:GetAttributes()) do
                    local name = key:lower()
                    if type(value) == "number" and (name:find("cooldown", 1, true) or name == "cd"
                        or name:find("delay", 1, true) or name:find("time", 1, true)
                        or name:find("duration", 1, true) or name:find("hold", 1, true)) then
                        pcall(function() obj:SetAttribute(key, 0) end)
                    end
                end
            end
        end
    end
end

processFoodQuest = function(alive, status)
    local foodsRoot = resolvePath(workspace, FoodQuest.FoodsPath, "Food")
    local tablesRoot = resolvePath(workspace, FoodQuest.TablesPath, "Food")
    if not foodsRoot or not tablesRoot then
        status("No food found")
        task.wait(0.5)
        return
    end
    local processed = {}
    local missingSince
    makeFoodTablesInstant()
    while alive() do
        -- Reaplica em runtime para os ProximityPrompts 1–4 manterem HoldDuration = 0.
        makeFoodTablesInstant()
        local cur, total = getQuestProgress()
        if cur and total and cur >= total then return true end
        if AutoAccept.Enabled and QuestState.npcDone and repeatAcceptShown() then return true end
        if not questUiShown() then
            missingSince = missingSince or os.clock()
            if os.clock() - missingSince >= 3 then return true end
        else
            missingSince = nil
        end

        local found = false
        for _, prompt in ipairs(foodsRoot:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") and prompt.Enabled and not processed[prompt] then
                found = true
                processed[prompt] = true

                local names = foodPromptName(prompt, foodsRoot)
                local itemName = prompt.ObjectText ~= "" and prompt.ObjectText or nil
                if not itemName or itemName == "" then
                    local node = prompt.Parent
                    while node and node.Parent and node.Parent ~= foodsRoot do node = node.Parent end
                    itemName = node and node.Name or names[#names] or "comida"
                end

                local foodPos = locationPosition(prompt.Parent)
                if foodPos and teleportTo(foodPos, 2) then
                    local before = getQuestProgress()
                    before = before or 0
                    log("Food", "comida coletada: " .. tostring(itemName) .. "; iniciando giro pelas quatro mesas")
                    firePrompt(prompt)

                    -- Mantém a comida atual como pendente e percorre as quatro mesas.
                    -- Só procura a próxima comida quando o contador da quest avançar.
                    local progressed = false
                    while alive() and not progressed do
                        for index = 1, 4 do
                            if not alive() then return end
                            makeFoodTablesInstant(index)
                            local destPrompt, tableTarget = tablePrompt(tablesRoot, index)
                            -- O destino do giro é explicitamente o modelo Workspace.Tables.Table 1..4.
                            local namedTable = numberedTable(tablesRoot, index)
                            -- Usa a posição do próprio prompt para ficar dentro do alcance do E.
                            local tablePos = (destPrompt and locationPosition(destPrompt.Parent))
                                or (tableTarget and locationPosition(tableTarget))
                                or (namedTable and locationPosition(namedTable))
                            if tablePos and teleportTo(tablePos, 1.5) then
                                log("Food", string.format("indo para Workspace.Tables.Table %d", index))
                                -- Sem espera/polling entre mesas: tenta interagir imediatamente ao chegar.
                                if alive() and destPrompt then
                                    pcall(function()
                                        destPrompt.HoldDuration = 0
                                        destPrompt.RequiresLineOfSight = false
                                        destPrompt.MaxActivationDistance = math.max(destPrompt.MaxActivationDistance, 40)
                                    end)
                                    -- Envia a tecla de interação E; se o executor não oferecer VIM,
                                    -- usa o acionamento direto do ProximityPrompt como reserva.
                                    if not pressKey(Enum.KeyCode.E, 0.03) then
                                        firePrompt(destPrompt)
                                    end
                                    log("Food", string.format("E enviado: %s na mesa %d", tostring(itemName), index))
                                else
                                    log("Food", string.format("mesa %d ou prompt não encontrado", index), true)
                                end
                            else
                                log("Food", string.format("posição da mesa %d não encontrada", index), true)
                            end
                            if index < 4 and alive() then task.wait(FoodQuest.TableDelay) end
                        end

                        local after, total = getQuestProgress()
                        if after and after > before then
                            progressed = true
                            log("Food", string.format("quest avançou: %d/%d; buscando a próxima comida", after, total or 4))
                            status(T("Collecting food") .. ": " .. tostring(after) .. "/" .. tostring(total or 4))
                        elseif AutoAccept.Enabled and QuestState.npcDone and repeatAcceptShown() then
                            return true
                        elseif after and total and after >= total then
                            return true
                        else
                            -- Sem avanço: tenta novamente as quatro mesas com a comida pendente.
                            RunService.Heartbeat:Wait()
                        end
                    end
                end

                if not alive() then return end
                cur, total = getQuestProgress()
                if cur and total and cur >= total then return true end
                if AutoAccept.Enabled and QuestState.npcDone and repeatAcceptShown() then return true end
            end
        end
        if not found then
            status("No food found")
            task.wait(0.1)
        end
        RunService.Heartbeat:Wait()
    end
end

----------------------------------------------------------------------
-- LOOP DO FARM DE NÍVEL
-- A etapa é escolhida pelo nível a cada volta:
--   nível 0-10   -> Zack: aceita a quest e mata os Bandits (runZackQuest, mais abaixo)
--   nível 11-109 -> Mari/frutas; nível 110-250 -> Jaqin/comida e mesas
-- Nas duas, depois da 1ª missão, o botão "Aceitar" repete a quest sem voltar no NPC.
----------------------------------------------------------------------
local runZackQuest   -- definida mais abaixo (usa os helpers de ataque do farm de banana)

local function startNpcFarm(onStatus)
    -- Auto aceitar missão faz parte do Auto Farm Level e não possui toggle separado.
    AutoAccept.Enabled = true
    npcToken += 1
    local mine = npcToken
    NpcFarm.Enabled = true
    QuestState.active, QuestState.kills, QuestState.total, QuestState.text = false, 0, 5, nil
    QuestState.kind = nil
    QuestState.npcDone = false   -- o NPC só é usado na 1ª vez de cada etapa; depois vale o botão "Aceitar"
    local function alive() return NpcFarm.Enabled and npcToken == mine end
    local function status(text) if alive() then safe(onStatus, text) end end
    local cycle = 0
    local cancelled = false
    log("NPC", "farm de nível ligado")

    task.spawn(guard("NPC", function()
        while alive() do
            if QuestState.active then
                -- missão aceita: mata os Bandits (Zack) ou coleta as frutas (Mari) até terminar
                if QuestState.kind == "zack" then
                    runZackQuest(alive, status)
                elseif QuestState.kind == "mari" then
                    collectFruitsForQuest(alive, status)
                else
                    processFoodQuest(alive, status)
                end
                if alive() then
                    QuestState.active = false
                    status("Idle")

                    -- se o nível já é de outra etapa, a próxima missão é pelo NPC dela (o "Aceitar" não vale)
                    local lv = getPlayerLevel()
                    if lv and stageForLevel(lv) ~= QuestState.kind then
                        log("NPC", string.format("level %d mudou de etapa, indo falar com o NPC novo", lv))
                        QuestState.npcDone = false
                    end

                    -- 2ª forma: depois da 1ª missão (feita pelo NPC), aceita direto no botão "Aceitar"
                    if AutoAccept.Enabled and QuestState.npcDone then
                        status("Accepting repeat quest...")
                        if startQuestViaRepeat(alive) then
                            log("NPC", "missão repetida aceita pelo botão Aceitar (sem ir no NPC)")
                            status("Dialog confirmed")
                        else
                            log("NPC", "botão Aceitar não funcionou, voltando para o NPC", true)
                        end
                    else
                        log("NPC", "missão terminada, voltando para o NPC")
                    end
                end
            else
                local level = getPlayerLevel()
                local stage = level and stageForLevel(level)
                if not level then
                    status("Level not found")
                    task.wait(1)
                elseif not stage then
                    -- fora de 0-290: o toggle fica ligado, mas não faz nada (nem cancela, nem vai no NPC)
                    log("NPC", string.format("level %d fora de %d-%d, aguardando",
                        level, ZackQuest.MinLevel, FoodQuest.MaxLevel))
                    status("Level out of range")
                    task.wait(1)
                else
                    local npcCfg = stage == "zack" and ZackQuest or stage == "food" and FoodQuest or QuestNpc
                    local cfgArg = stage == "zack" and ZackQuest or stage == "food" and FoodQuest or nil -- nil = Mari

                    -- ao iniciar: cancela qualquer missão em andamento para começar do zero
                    if not cancelled then
                        status("Cancelling quest...")
                        cancelQuest(alive)
                        cancelled = true
                    end

                    if alive() then
                        cycle += 1
                        log("NPC", string.format("ciclo %d: level %d (etapa %s), indo falar com %s",
                            cycle, level, stage, tostring(npcCfg.Name)))
                        local target, pos = findNpcTarget(cfgArg)
                        if not target then
                            status("NPC not found")
                            task.wait(1)
                        elseif not teleportTo(pos, 3) then
                            status("Character not found")
                        else
                            status("Interacting...")
                            task.wait(0.25)
                            local yes
                            for attempt = 1, 3 do
                                if not alive() then break end
                                log("NPC", string.format("ciclo %d: tentativa %d de interagir", cycle, attempt))
                                interactWith(target, attempt)
                                yes = waitForYes(1.5, alive)
                                if yes then break end
                            end
                            if yes and alive() then
                                pressButton(yes)
                                log("NPC", string.format("ciclo %d: Yes pressionado", cycle))
                                status("Dialog confirmed")

                                -- espera a missão aparecer na tela; só então começa (lutar / coletar)
                                local shown, t = false, 0
                                while t < 2.5 and alive() do
                                    if questUiShown() then shown = true break end
                                    task.wait(0.1)
                                    t += 0.1
                                end
                                if shown and alive() then
                                    local _, total, text = getQuestProgress()
                                    QuestState.active = true
                                    QuestState.kind = stage
                                    QuestState.npcDone = true   -- 1ª aceitação feita: as próximas usam o botão "Aceitar"
                                    QuestState.kills = 0
                                    QuestState.total = total or 5
                                    QuestState.text = text
                                    log("NPC", string.format("missão aceita (%s, meta %d): '%s'",
                                        stage, QuestState.total, tostring(text)))
                                else
                                    log("NPC", "Yes pressionado mas a missão não apareceu na tela, tentando de novo", true)
                                end
                            else
                                status("Yes button not found")
                            end
                        end

                        -- sem cooldown: só 1 frame para nunca travar o jogo se algo falhar
                        task.wait()
                    end
                end
            end
        end
    end))
end

----------------------------------------------------------------------
-- FARM ITEM: BANANA
-- Mata SÓ os "Warrior Monkey [45+]" em Workspace.World.Playability.Enemys.
-- A banana vem dos NPCs; o contador lê o inventário (texto "2 / 650").
-- Opção "Take quest": ligada = pega a quest antes de matar; desligada = só mata.
----------------------------------------------------------------------
local BANANA_COLLIDE = {
    HumanoidRootPart = true, Head = true, Torso = true,
    UpperTorso = true, LowerTorso = true,
}

local BananaFarm = {
    Enabled      = false,
    TakeQuest    = true, -- procura o Adventurer e aceita a quest automaticamente
    EnemyPath    = { "World", "Playability" },
    EnemyName    = "Warrior Monkey [45+]", -- nome EXATO do inimigo (só ele é atacado)
    QuestNpcPath = { "World", "IgnoreList", "Npcs", "Interactive", "JungleIsland" },
    QuestNpcName = "Adventurer",           -- NPC que dá a quest dos macacos (ajuste se for outro)
    Distance     = nil,                   -- nil = o mais perto possível, calculado pelo tamanho dos dois
    Height       = 3,                      -- studs acima do chão do inimigo
    KillTimeout  = 25,                     -- desiste de um inimigo após X segundos
    Slot         = 1,                      -- slot da hotbar (1-9) usado para bater
    FakeInput    = true,                   -- dispara o M1 nos scripts do jogo (InputBegan) sem mouse
    ClickSeries  = 5,                      -- cliques por rajada
    ClickInterval = 0.3,                    -- legado; o valor universal Config.Combat é usado
    Burst        = 1,                        -- legado; o valor universal Config.Combat é usado
    Reposition   = 4,                       -- só reposiciona se o alvo se afastar mais que isto
    Gained       = 0,                      -- bananas ganhas nesta sessão
}
local bananaToken = 0
local bananaStart
local bananaLastEnemyPos
local bananaQuestPos
local BANANA_INV = { "Interfaces", "Frames", "Inventory", "Inventory", "Background", "ScrollingFrame" }

-- lê o inventário: devolve atual, máximo (ex.: 2, 650) ou nil
local function getBananaCount()
    local pg = Players.LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local list = resolvePath(pg, BANANA_INV, "Banana")
    if not list then return nil end
    local item
    for _, c in ipairs(list:GetChildren()) do
        if c.Name:lower():find("banana") then item = c break end
    end
    if not item then return 0, nil end -- sem banana no inventário = 0
    for _, d in ipairs(item:GetDescendants()) do
        if d:IsA("TextLabel") then
            local a, b = d.Text:match("(%d+)%s*/%s*(%d+)")
            if a then return tonumber(a), tonumber(b) end
        end
    end
    return nil
end

local function normName(n) return (n:lower():gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")) end

local function enemyPos(m)
    local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true)
    return r and r.Position or m:GetPivot().Position, r
end

local function isBananaEnemy(m)
    if not m:IsA("Model") or normName(m.Name) ~= normName(BananaFarm.EnemyName) then return false end
    local hum = m:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end
    return true
end

local bananaListed = false
-- inimigos vivos, do mais próximo para o mais longe
local function listBananaEnemies()
    local out = {}
    local root = resolvePath(workspace, BananaFarm.EnemyPath, "Banana")
    if not root then return out end
    for _, m in ipairs(root:GetDescendants()) do
        if isBananaEnemy(m) then table.insert(out, m) end
    end
    if #out == 0 and not bananaListed then
        bananaListed = true
        local seen, names = {}, {}
        for _, c in ipairs(root:GetChildren()) do
            if not seen[c.Name] then seen[c.Name] = true table.insert(names, c.Name) end
        end
        log("Banana", string.format("nenhum '%s' carregado. Inimigos carregados: %s",
            BananaFarm.EnemyName, #names > 0 and table.concat(names, " | ") or "nenhum"), true)
    elseif #out > 0 then
        bananaListed = false
    end
    local hrp = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        table.sort(out, function(x, y)
            return (enemyPos(x) - hrp.Position).Magnitude < (enemyPos(y) - hrp.Position).Magnitude
        end)
    end
    return out
end

-- slot (1-9) da hotbar usado para bater; o script equipa sozinho se não estiver na mão
local SLOT_KEYS = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five,
                    Enum.KeyCode.Six, Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine }
local SLOT_EQUIP_DELAY = 0.15
equipSharedSlotNow = function()
    local player = Players.LocalPlayer
    local char = player and player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end

    local slot = math.clamp(math.floor(SharedWeaponSlot), 1, 9)
    pressKey(SLOT_KEYS[slot], 0.02)
    task.wait(SLOT_EQUIP_DELAY)
    local cur = char:FindFirstChildOfClass("Tool")
    if not cur then
        local tools = {}
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then table.insert(tools, tool) end
            end
        end
        local tool = tools[slot]
        if tool then
            pcall(function() hum:EquipTool(tool) end)
            cur = tool
        end
    end
    if cur then bananaToolName, zackToolName = cur.Name, cur.Name end
    return cur
end

local function ensureBananaSlot()
    local char = Players.LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local cur = char:FindFirstChildOfClass("Tool")
    if cur and bananaToolName and cur.Name == bananaToolName then return end -- já está com o slot certo

    local slot = math.clamp(math.floor(SharedWeaponSlot), 1, 9)
    -- 1) aperta a tecla do slot (funciona na hotbar padrão e na maioria das customizadas)
    pressKey(SLOT_KEYS[slot], 0.02)
    task.wait(SLOT_EQUIP_DELAY)
    cur = char:FindFirstChildOfClass("Tool")
    -- 2) fallback: a N-ésima ferramenta (Backpack + mão) pela ordem
    if not cur then
        local tools = {}
        local bp = Players.LocalPlayer:FindFirstChild("Backpack")
        if bp then for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(tools, t) end end end
        local t = tools[slot]
        if t then pcall(function() hum:EquipTool(t) end) cur = t end
    end
    if cur then
        bananaToolName = cur.Name
        log("Banana", string.format("slot %d equipado: %s", slot, cur.Name))
    else
        log("Banana", string.format("nenhuma ferramenta no slot %d", slot), true)
    end
end

-- M1 sintético desativado: callbacks manuais de mouse podem interferir na interface.
local function fireFakeM1()
    return false
end

-- Clique real no alvo: alguns inimigos só registram o golpe quando recebem clique na tela.
local function realClickEnemy(enemy)
    if not enemy or not enemy.Parent then return false end
    return clickNpcOnScreen(enemy, true)
end

-- um "ataque": todos os métodos sem precisar do jogador clicar
local function bananaHit(enemy, cds)
    -- O painel não deve bloquear o farm: os alvos são acionados diretamente por Tool/ClickDetector.
    local previousAutoLock = autoInputLock
    autoInputLock = true
    if fireclickdetector then
        for _, cd in ipairs(cds) do pcall(fireclickdetector, cd) end
    end
    local char = Players.LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
        if firesignal then pcall(firesignal, tool.Activated) end
    end
    realClickEnemy(enemy)
    autoInputLock = previousAutoLock
end

-- ClickDetectors do inimigo
local function enemyClickDetectors(enemy)
    local out = {}
    for _, d in ipairs(enemy:GetDescendants()) do
        if d:IsA("ClickDetector") then table.insert(out, d) end
    end
    return out
end

-- mata um inimigo: gruda atrás dele e bate em séries (ClickSeries x ClickInterval)
local function killBananaEnemy(enemy, alive)
    local hum = enemy:FindFirstChildOfClass("Humanoid") or enemy:FindFirstChildWhichIsA("Humanoid", true)
    local t0 = os.clock()
    log("Banana", "atacando " .. enemy:GetFullName())

    -- Mesmo sistema do farm do Zack: teleporta para o lado mais próximo,
    -- fica parado durante a rajada e só reposiciona se o alvo se afastar.
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local function bananaStick()
        if not alive() then return false end
        local char = Players.LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp or not enemy.Parent then return false end

        local epos, er = enemyPos(enemy)
        bananaLastEnemyPos = epos
        local chum = char:FindFirstChildOfClass("Humanoid")

        local gap = math.min(er and er.Size.X or 2, 4) / 2 + hrp.Size.X / 2 + 0.2
        local dist = BananaFarm.Distance or gap
        if (hrp.Position - epos).Magnitude <= dist + BananaFarm.Reposition then
            return true
        end

        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") and BANANA_COLLIDE[part.Name] then
                part.CanCollide = true
            end
        end
        hrp.Anchored = false
        if chum then
            chum.PlatformStand = false
            pcall(function()
                if chum:GetState() == Enum.HumanoidStateType.StrafingNoPhysics then
                    chum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end)
        end

        local right = er and er.CFrame.RightVector or Vector3.new(1, 0, 0)
        right = Vector3.new(right.X, 0, right.Z)
        right = right.Magnitude > 0.01 and right.Unit or Vector3.new(1, 0, 0)

        rayParams.FilterDescendantsInstances = { char, enemy }
        local hip = chum and chum.HipHeight or 2
        if chum and chum.RigType == Enum.HumanoidRigType.R6 then hip = 2 end

        local stand
        for _, dir in ipairs({ right, -right }) do
            local side = epos + dir * dist
            local hit = workspace:Raycast(side + Vector3.new(0, 8, 0), Vector3.new(0, -300, 0), rayParams)
            if hit then
                stand = Vector3.new(side.X, hit.Position.Y + hrp.Size.Y / 2 + hip + 0.05, side.Z)
                break
            end
        end
        stand = stand or Vector3.new(epos.X + right.X * dist, epos.Y, epos.Z + right.Z * dist)

        if not alive() then return false end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = CFrame.lookAt(stand, Vector3.new(epos.X, stand.Y, epos.Z))
        log("Banana", "teleporte/reposicionamento para perto de " .. enemy.Name)
        return true
    end
    local function stillAlive()
        return alive() and enemy.Parent and (not hum or hum.Health > 0)
            and os.clock() - t0 < BananaFarm.KillTimeout
    end

    local ok, err = pcall(function()
        ensureBananaSlot()
        local cds = enemyClickDetectors(enemy)
        log("Banana", string.format("%d ClickDetector(s) no inimigo", #cds))
        while stillAlive() do
            for _ = 1, BananaFarm.ClickSeries do
                if not stillAlive() or not bananaStick() then break end
                bananaHit(enemy, cds)
                local w = 0
                while w < universalAttackInterval() and stillAlive() do
                    bananaStick()
                    w += RunService.Heartbeat:Wait()
                end
            end

            -- intervalo entre rajadas, igual ao farm do Zack
            local waited = 0
            while waited < universalBurstInterval() and stillAlive() do
                bananaStick()
                waited += RunService.Heartbeat:Wait()
            end
            ensureBananaSlot()
        end
    end)
    if not ok then log("Banana", "erro no ataque: " .. tostring(err), true) end

    if hum and hum.Health <= 0 then log("Banana", "inimigo morto") end
end

-- pega a quest: mesmo sistema da Mari (botão "Aceitar" se aparecer; senão NPC -> interagir -> Yes)
local function takeBananaQuest(alive, status)
    if repeatAcceptShown() then
        status("Accepting repeat quest...")
        if acceptRepeatQuest(alive, AutoAccept.Timeout) then return true end
    end
    if questUiShown() then return true end -- já tem quest

    -- Usa uma configuração local para não sobrescrever a Mari/QuestNpc globalmente.
    local bananaNpc = {
        Name = BananaFarm.QuestNpcName,
        Path = BananaFarm.QuestNpcPath,
        LastPos = bananaQuestPos or recallNpcPos(BananaFarm.QuestNpcName, BananaFarm.QuestNpcPath),
    }
    local target, pos = findNpcTarget(bananaNpc)
    bananaQuestPos = bananaNpc.LastPos
    if not target then
        status("NPC not found")
        return false
    end
    if not teleportTo(pos, 3) then
        status("Character not found")
        return false
    end
    status("Interacting...")
    task.wait(0.05)
    local yes
    for attempt = 1, 3 do
        if not alive() then return false end
        log("Banana", string.format("tentativa %d de interagir com %s", attempt, BananaFarm.QuestNpcName))
        interactWith(target, attempt, true)
        yes = waitForYes(0.8, alive)
        if yes then break end

        -- O prompt pode não abrir o diálogo mesmo sem erro; tenta clicar diretamente no NPC.
        log("Banana", "diálogo ainda não abriu; tentando clique real no Adventurer", true)
        clickNpcOnScreen(target, true)
        task.wait(0.15)
        yes = waitForYes(1.2, alive)
        if yes then break end
    end
    if not (yes and alive()) then
        status("Yes button not found")
        return false
    end
    pressButton(yes)
    status("Dialog confirmed")
    local t = 0
    while t < 2.5 and alive() do
        if questUiShown() then
            QuestState.npcDone = true
            log("Banana", "quest aceita")
            return true
        end
        task.wait(0.1)
        t += 0.1
    end
    log("Banana", "Yes pressionado mas a quest não apareceu na tela", true)
    return false
end

local function stopBananaFarm()
    BananaFarm.Enabled = false
    bananaToken += 1
end

local function startBananaFarm(onStatus)
    bananaToken += 1
    local mine = bananaToken
    BananaFarm.Enabled = true
    local function alive() return BananaFarm.Enabled and bananaToken == mine end
    local function status(text) if alive() then safe(onStatus, text) end end
    local startCount = getBananaCount()
    bananaStart = startCount or 0
    BananaFarm.Gained = 0
    bananaToolName = nil
    bananaListed = false
    local lastQuestTry = 0

    log("Banana", "farm de banana ligado (quest: " .. tostring(BananaFarm.TakeQuest) .. ")")

    task.spawn(guard("Banana", function()
        if BananaFarm.TakeQuest and questUiShown() then
            status("Cancelling quest...")
            cancelQuest(alive) -- começa do zero, igual ao farm de nível
        end
        while alive() do
            -- A etapa da quest pode se deslocar/interagir mesmo com o painel aberto.
            if BananaFarm.TakeQuest and not questUiShown() and os.clock() - lastQuestTry > 2 then
                lastQuestTry = os.clock()
                takeBananaQuest(alive, status)
            end

            -- Continua até os macacos e ataca mesmo com o painel expandido.
            -- O farm não usa clique de tela no alvo, então a janela não precisa pausá-lo.
            -- 2) mata os Warrior Monkey [45+]
            local enemies = listBananaEnemies()
            if #enemies == 0 then
                status("No enemy found")
                if bananaLastEnemyPos then
