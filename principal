-- procura o ProximityPrompt do NPC: dentro do Model (inclui o "Interact") e,
-- se não achar, em qualquer prompt do workspace a até 30 studs do NPC
local function findNpcPrompt(model)
    local found = {}
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("ProximityPrompt") then table.insert(found, d) end
    end
    local pos = npcPosition(model)
    if #found == 0 then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ProximityPrompt") and d.Parent then
                local p = locationPosition(d.Parent)
                if p and (p - pos).Magnitude <= 30 then table.insert(found, d) end
            end
        end
    end
    if #found == 0 then return nil end

    -- prefere prompt ativo e o mais próximo do NPC
    table.sort(found, function(x, y)
        if x.Enabled ~= y.Enabled then return x.Enabled end
        local px = x.Parent and locationPosition(x.Parent) or pos
        local py = y.Parent and locationPosition(y.Parent) or pos
        return (px - pos).Magnitude < (py - pos).Magnitude
    end)
    return found[1], #found
end

-- dispara um ProximityPrompt NA HORA: HoldDuration = 0 (sem segurar), sem linha de visão, alcance maior
local function firePrompt(prompt)
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 40)
    end)
    if typeof(fireproximityprompt) == "function" then
        local ok, err = pcall(fireproximityprompt, prompt)
        if ok then
            log("Interact", string.format("fireproximityprompt em %s (Enabled=%s, Action='%s')",
                prompt:GetFullName(), tostring(prompt.Enabled), prompt.ActionText))
            return true
        end
        log("Interact", "fireproximityprompt falhou: " .. tostring(err), true)
    else
        log("Interact", "executor sem fireproximityprompt, usando InputHoldBegin/End", true)
    end
    local ok, err = pcall(function()
        prompt:InputHoldBegin()
        prompt:InputHoldEnd()
    end)
    if not ok then log("Interact", "InputHoldBegin/End falhou: " .. tostring(err), true) end
    return ok
end

