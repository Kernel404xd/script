    function FruitFeature.toolStillOwned(tool)
        local player = Players.LocalPlayer
        local character = player and player.Character
        local backpack = player and player:FindFirstChild("Backpack")
        return tool and ((character and tool:IsDescendantOf(character))
            or (backpack and tool:IsDescendantOf(backpack))) or false
    end

    function FruitFeature.processCollectedFruit(fruitName, before, token, fruitHandle)
        log("Fruit", "pós-coleta: fruta=" .. tostring(fruitName) .. " modo=" .. tostring(FruitFeature.ActionMode))
        if FruitFeature.ActionMode == "Nenhuma ação" then
            FruitFeature.PickStatus:SetText("Fruta coletada; ação automática desativada")
            return
        end
        local tool
        for _ = 1, 30 do
            if not FruitFeature.PickEnabled or FruitFeature.PickToken ~= token then return end
            tool = FruitFeature.findFruitTool(fruitName, before)
            if tool then break end
            task.wait(0.1)
        end
        if not tool then
            FruitFeature.PickStatus:SetText("Fruta coletada; Tool não encontrada")
            local names = {}
            local playerNow = Players.LocalPlayer
            local backpackNow = playerNow and playerNow:FindFirstChild("Backpack")
            local characterNow = playerNow and playerNow.Character
            for _, container in ipairs({ backpackNow, characterNow }) do
                if container then for _, child in ipairs(container:GetChildren()) do
                    if child:IsA("Tool") then table.insert(names, child.Name) end
                end end
            end
            log("Fruit", "Tool não detectada após 3s. Ferramentas encontradas: " .. table.concat(names, ", "), true)
            return
        end
        log("Fruit", "Tool detectada: " .. tool:GetFullName() .. " | nome=" .. tool.Name)
        local player = Players.LocalPlayer
        local character = player and player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local backpack = player and player:FindFirstChild("Backpack")
        local slotNumber
        if backpack then
            local slot = 0
            for _, item in ipairs(backpack:GetChildren()) do
                if item:IsA("Tool") then
                    slot += 1
                    if item == tool then slotNumber = slot break end
                end
            end
        end
        -- Seleciona o slot da hotbar quando conhecido; usa EquipTool como fallback.
        if tool.Parent ~= character and slotNumber and slotNumber >= 1 and slotNumber <= #SLOT_KEYS then
            pressKey(SLOT_KEYS[slotNumber], 0.04)
            task.wait(0.12)
        end
        if tool.Parent ~= character and humanoid then
            local equipOk, equipErr = pcall(function() humanoid:EquipTool(tool) end)
            log("Fruit", "Humanoid:EquipTool(" .. tool.Name .. "): " .. tostring(equipOk) .. (equipErr and (" | " .. tostring(equipErr)) or ""), not equipOk)
        end
        log("Fruit", "slot=" .. tostring(slotNumber or "desconhecido") .. " | equipado=" .. tostring(tool.Parent == character))
        local mode = FruitFeature.ActionMode
        if mode == "Nenhuma ação" then
            FruitFeature.PickStatus:SetText("Fruta coletada; ação automática desativada")
            return
        end
        FruitFeature.PickStatus:SetText("Aguardando 1s antes de abrir: " .. fruitName)
        log("Fruit", "slot equipado; iniciando espera de 1s antes do clique central")
        task.wait(1) -- atraso após equipar o slot da fruta
        FruitFeature.PickStatus:SetText("Abrindo interface: " .. fruitName)
        local opened = FruitFeature.openFruitInterface(fruitHandle)
        if not opened then
            FruitFeature.PickStatus:SetText("Não foi possível abrir a interface da fruta")
            return
        end
        task.wait(1) -- espera a interface abrir após o toque central

        local buttonName = mode == "Auto Comer" and "Eat" or "Store"
        FruitFeature.PickStatus:SetText(string.format("%s: %s", buttonName, fruitName))
        local actionButton = FruitFeature.waitFruitButton(buttonName, token)
        if not actionButton then
            FruitFeature.PickStatus:SetText("Botão " .. buttonName .. " não visível no caminho Physical Fruits")
            log("Fruit", "não achei botão visível: PlayerGui.Interfaces.Frames.Physical Fruits.EatFruit.Buttons." .. buttonName, true)
            return
        end
        if not FruitFeature.clickFruitButton(actionButton) then
            FruitFeature.PickStatus:SetText("Falha ao clicar em " .. buttonName)
            log("Fruit", "clique falhou em " .. actionButton:GetFullName(), true)
            return
        end
        task.wait(0.65)
        log("Fruit", "após clique " .. buttonName .. ": tool ainda no inventário=" .. tostring(FruitFeature.toolStillOwned(tool)))

        if mode == "Auto Dropar" and FruitFeature.toolStillOwned(tool) then
            local dropButton = FruitFeature.waitFruitButton("Drop", token)
            if dropButton and FruitFeature.toolStillOwned(tool) then
                FruitFeature.PickStatus:SetText("Store falhou; dropando: " .. fruitName)
                FruitFeature.clickFruitButton(dropButton)
                task.wait(0.4)
            end
        elseif mode == "Auto Comer" then
            FruitFeature.PickStatus:SetText("Comida: " .. fruitName)
        else
            FruitFeature.PickStatus:SetText("Store solicitado: " .. fruitName)
        end
    end

    FruitFeature.Section:AddDropdown({
        Name = "Action after pickup",
        Options = { "No action", "Auto Drop", "Auto Eat", "Auto Store" },
        Default = ({ ["Nenhuma ação"] = "No action", ["Auto Dropar"] = "Auto Drop", ["Auto Comer"] = "Auto Eat", ["Auto Guardar"] = "Auto Store" })[FruitFeature.ActionMode] or "No action",
        Callback = function(value)
            local modeByLabel = { ["No action"] = "Nenhuma ação", ["Auto Drop"] = "Auto Dropar", ["Auto Eat"] = "Auto Comer", ["Auto Store"] = "Auto Guardar" }
            FruitFeature.ActionMode = modeByLabel[value] or value
        end,
    })

    function FruitFeature.runAutoPick(token)
        while FruitFeature.PickEnabled and FruitFeature.PickToken == token do
            local targets, folderFound = FruitFeature.findTargets()
            if not folderFound then
                FruitFeature.PickStatus:SetText("DroppedTools não encontrada")
                task.wait(1)
            elseif #targets == 0 then
                FruitFeature.PickStatus:SetText("Aguardando frutas...")
                task.wait(0.5)
            else
                for _, target in ipairs(targets) do
                    if not FruitFeature.PickEnabled or FruitFeature.PickToken ~= token then break end
                    local handle, prompt = target.Handle, target.Prompt
                    if handle and handle.Parent and prompt and prompt.Parent and prompt.Enabled then
                        local fruitName = tostring(prompt.ObjectText or ""):gsub("^%s+", ""):gsub("%s+$", "")
                        if fruitName == "" then fruitName = "Fruta" end
                        local character = Players.LocalPlayer and Players.LocalPlayer.Character
                        local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
                        if playerRoot then
                            FruitFeature.PickStatus:SetText("Trazendo: " .. fruitName)
                            -- Move a fruta para perto do jogador; não teleporta o personagem.
                            local ok = pcall(function()
                                handle.AssemblyLinearVelocity = Vector3.zero
                                handle.CFrame = playerRoot.CFrame * CFrame.new(0, 0, -2)
                            end)
                            if ok then
                                task.wait(0.2)
                                if FruitFeature.PickEnabled and FruitFeature.PickToken == token
                                    and handle.Parent and prompt.Parent and prompt.Enabled then
                                    local beforeTools = FruitFeature.snapshotTools()
                                    FruitFeature.PickStatus:SetText("Interagindo com E: " .. fruitName)
                                    log("Fruit", "antes de E: " .. fruitName .. " | posição=" .. tostring(handle.Position))
                                    local eOk, eResult = FruitFeature.interactWithFruit()
                                    log("Fruit", "envio da tecla E: " .. tostring(eOk) .. " | resultado=" .. tostring(eResult), not eOk)
                                    task.wait(0.25) -- aguarda o servidor registrar a coleta
                                    FruitFeature.processCollectedFruit(fruitName, beforeTools, token, handle)
                                end
                                task.wait(0.45)
                            else
                                FruitFeature.PickStatus:SetText("Não foi possível mover: " .. fruitName)
                                task.wait(0.5)
                            end
                        else
                            FruitFeature.PickStatus:SetText("Personagem indisponível")
                            task.wait(0.5)
                        end
                    end
                end
            end
        end
        FruitFeature.PickStatus:SetText("Coleta: Desativada")
    end

    FruitFeature.Section:AddToggle({
        Name = "Auto Pick Fruits",
        Callback = function(enabled)
            FruitFeature.PickEnabled = enabled
            FruitFeature.PickToken += 1
            if enabled then
                FruitFeature.PickStatus:SetText("Procurando frutas...")
                task.spawn(FruitFeature.runAutoPick, FruitFeature.PickToken)
            else
                FruitFeature.PickStatus:SetText("Coleta: Desativada")
            end
        end,
    })
end

