            bananaToolName, zackToolName = nil, nil
            if equipSharedSlotNow then equipSharedSlotNow() end
            local miscCombat = Config.MiscCombatWidgets
            if miscCombat then
                if miscCombat.weaponSlot then miscCombat.weaponSlot:Set("1", true) end
                if miscCombat.speed then miscCombat.speed:Set(tostring(Config.Combat.Speed) .. "%", true) end
                if miscCombat.interval then miscCombat.interval:Set(string.format("%.2f s", Config.Combat.Interval), true) end
                if miscCombat.burst then miscCombat.burst:Set(string.format("%.2f s", Config.Combat.BurstInterval), true) end
                for skill, widget in pairs(miscCombat.autoSkills or {}) do
