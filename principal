-- posições conhecidas das NPCs, guardadas em arquivo: valem também depois de reexecutar o script.
-- (com StreamingEnabled a NPC longe do player não está carregada; sem a posição o script não acha ela)
local NPC_POS_FILE = "Kernel404_npcs.json"
local savedNpcPos = {}
pcall(function()
    if typeof(isfile) == "function" and typeof(readfile) == "function" and isfile(NPC_POS_FILE) then
        local data = HttpService:JSONDecode(readfile(NPC_POS_FILE))
        if type(data) == "table" then savedNpcPos = data end
    end
end)

Config._NpcPosStorageKey = function(name, path)
    if type(path) == "table" and #path > 0 then
        return table.concat(path, ".") .. "." .. tostring(name)
    elseif type(path) == "string" and path ~= "" then
        return path .. "." .. tostring(name)
    end
    return tostring(name)
end

Config._DecodeNpcPos = function(p)
    if type(p) == "table" and tonumber(p[1]) and tonumber(p[2]) and tonumber(p[3]) then
        return Vector3.new(p[1], p[2], p[3])
    end
end

local function recallNpcPos(name, path)
    if not name then return nil end
    return Config._DecodeNpcPos(savedNpcPos[Config._NpcPosStorageKey(name, path)])
        or Config._DecodeNpcPos(savedNpcPos[name]) -- lê também os arquivos da versão anterior (só nome)
end

local function rememberNpcPos(name, pos, path)
    if not name or not pos then return end
    local key = Config._NpcPosStorageKey(name, path)
    local old = Config._DecodeNpcPos(savedNpcPos[key]) or Config._DecodeNpcPos(savedNpcPos[name])
    if savedNpcPos[key] and old and (old - pos).Magnitude < 3 then return end
    savedNpcPos[key] = { pos.X, pos.Y, pos.Z }
    if typeof(writefile) == "function" then
        pcall(function() writefile(NPC_POS_FILE, HttpService:JSONEncode(savedNpcPos)) end)
    end
end

