-- Intervalos universais de combate. Todos os farms usam estes valores.
local function universalAttackInterval()
    local combat = Config.Combat or {}
    local speed = math.max(tonumber(combat.Speed) or 100, 5) / 100
    local interval = math.max(tonumber(combat.Interval) or 0.30, 0.03)
    return interval / speed
end

local function universalBurstInterval()
    local combat = Config.Combat or {}
    return math.max(tonumber(combat.BurstInterval) or 1.0, 0)
end

local CUSTOM_KEYS = { "Language", "AuraIntensity", "Transparency", "Particles", "AuraRainbow", "Debug", "PanelPosition" }

local function snapshot()
    local s = { Colors = {}, Combat = {}, AutoSkills = {} }
    for k, c in pairs(Config.Colors) do s.Colors[k] = c end
    for k, v in pairs(Config.Combat or {}) do s.Combat[k] = v end
    for k, v in pairs(Config.AutoSkills or {}) do s.AutoSkills[k] = v end
    for _, k in ipairs(CUSTOM_KEYS) do s[k] = Config[k] end
    return s
end

local function restore(s)
    for k, c in pairs(s.Colors) do Config.Colors[k] = c end
    if type(s.Combat) == "table" then
        for k, v in pairs(s.Combat) do Config.Combat[k] = v end
    end
    if type(s.AutoSkills) == "table" then
        for k, v in pairs(s.AutoSkills) do Config.AutoSkills[k] = v end
    end
    for _, k in ipairs(CUSTOM_KEYS) do Config[k] = s[k] end
end

