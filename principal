end

----------------------------------------------------------------------
-- CHEST FARM  (Workspace.World.Playability.Chests)
-- Passa por cada baú um por um, repete tudo ao terminar
-- e para na hora se o toggle for desativado.
----------------------------------------------------------------------
local ChestFarm = {
    Enabled = false,
    Delay   = 2,   -- segundos parado em cada posição
    Height  = 3,   -- studs acima da posição
}
local chestToken = 0

-- pasta dos baús: Workspace.World.Playability.Chests
-- (reserva: Workspace.World.IgnoreList.Chests, se a primeira não existir)
local function getChestFolder()
    local world = workspace:FindFirstChild("World")
    if not world then
        return nil
    end
    local play = world:FindFirstChild("Playability")
    local folder = play and play:FindFirstChild("Chests")
    if folder then
        return folder
    end
    local ignore = world:FindFirstChild("IgnoreList")
    folder = ignore and ignore:FindFirstChild("Chests")
    if folder then
        return folder
    end
    return nil
end

local function locationPosition(obj)
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then return obj:GetPivot().Position end
    if obj:IsA("Attachment") then return obj.WorldPosition end
end

-- lista tudo que está spawnado na pasta (entra em subpastas se houver)
local function collectChests()
    local list = {}
    local folder = getChestFolder()
    if not folder then return list end
    local function scan(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if locationPosition(child) then
                table.insert(list, child)
            elseif child:IsA("Folder") then
                scan(child)
            end
        end
    end
    scan(folder)
    return list
end

local function teleportTo(pos, height)
    local char = Players.LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        log("Teleport", "player sem HumanoidRootPart (personagem morto ou carregando?)", true)
        return false
    end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.new(pos + Vector3.new(0, height or ChestFarm.Height, 0))
    return true
end

local function stopChestFarm()
    ChestFarm.Enabled = false
    chestToken += 1 -- invalida qualquer loop em andamento
end

local function startChestFarm()
    chestToken += 1
    local mine = chestToken
    ChestFarm.Enabled = true

    task.spawn(guard("Chest", function()
        while ChestFarm.Enabled and chestToken == mine do
            local chests = collectChests()
            local visited = 0

            if #chests > 0 then
                -- passa por cada Location, uma por uma
                for _, loc in ipairs(chests) do
                    if not ChestFarm.Enabled or chestToken ~= mine then break end
                    -- o baú pode ter sumido (despawn) desde que a lista foi montada
                    local pos = loc.Parent and locationPosition(loc)
                    if pos and teleportTo(pos) then
                        visited += 1
                        -- espera em fatias pequenas para parar na hora ao desativar
                        local waited = 0
                        while waited < ChestFarm.Delay and ChestFarm.Enabled and chestToken == mine do
                            task.wait(0.1)
                            waited += 0.1
                        end
                    end
                end
            end

            -- terminou a volta (ou não achou nada): espera um instante e recomeça
            if visited == 0 then
                task.wait(1)
            else
                task.wait()
            end
        end
    end))
end

