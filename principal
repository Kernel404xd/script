----------------------------------------------------------------------
-- ETAPA 1 DO FARM DE NÍVEL (nível 0 a 10): QUEST DO ZACK  ("Defeat The Bandits (0/5)")
-- Depois de aceitar com o Zack, vai até os inimigos em Workspace.World.Playability.Enemys, equipa o
-- slot escolhido e ataca em rajadas: ZackQuest.Clicks cliques (1 a cada ZackQuest.Interval s), espera
-- ZackQuest.Burst s e repete, até a missão completar.
-- Conta os inimigos que o script matou; o contador do jogo "(x/y)" só serve de apoio.
-- Termina quando: a contagem chega na meta, a interface mostra completo, a janela "Repetir Missão"
-- aparece, ou a missão some da tela por 3s.
-- Movimento: UM teleporte para o LADO de cada inimigo (pés no chão, colisão ligada) e fica parado batendo.
-- Nada de seguir o inimigo frame a frame: só teleporta de novo para o próximo inimigo, ou se ele se
-- afastar mais que a distância + ZackQuest.Reposition. Sempre encosta no alvo (o mais perto possível).
----------------------------------------------------------------------
local zackLastEnemyPos        -- onde viu o último inimigo (para voltar se ele descarregar)
local zackEnemiesRoot         -- pasta dos inimigos (ignorada no raycast do chão)
local ZACK_COLLIDE = { HumanoidRootPart = true, Head = true, Torso = true, UpperTorso = true, LowerTorso = true }

-- "Defeat The Bandits (1/5)" -> "Bandit"
local function zackEnemyName(text)
    if ZackQuest.Enemy then return ZackQuest.Enemy end
    local t = (text or ""):gsub("%b()", "")
    t = t:gsub("^%s*[Dd]efeat%s+", ""):gsub("^[Tt]he%s+", ""):gsub("%s+$", "")
    t = t:gsub("s$", "")
    if t == "" then t = "Bandit" end
    return t
end

local function zackAlive(m)
    if not m or not m.Parent then return false end
    local hum = m:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

-- inimigo vivo mais próximo cujo nome contém `name`
local function zackNearest(name)
    local root = resolvePath(workspace, ZackQuest.EnemyPath, "Zack")
    if not root then return nil end
    zackEnemiesRoot = root
    local needle = name:lower()
    local char = Players.LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local best, bestDist, count = nil, nil, 0
    for _, d in ipairs(root:GetDescendants()) do
        if d:IsA("Model") and d.Name:lower():find(needle, 1, true) and zackAlive(d) then
            count += 1
            local dist = hrp and (hrp.Position - enemyPos(d)).Magnitude or 0
            if not bestDist or dist < bestDist then best, bestDist = d, dist end
        end
    end
    if best then
        log("Zack", string.format("alvo: %s a %.0f studs (%d '%s' vivos)", best:GetFullName(), bestDist or 0, count, name))
    end
    return best
end

-- equipa o slot escolhido (tecla 1-9; reserva: N-ésima ferramenta). Só mexe se a ferramenta certa não estiver na mão.
local function zackEnsureSlot()
    local char = Players.LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local cur = char:FindFirstChildOfClass("Tool")
    if cur and zackToolName and cur.Name == zackToolName then return end

    local slot = math.clamp(math.floor(SharedWeaponSlot), 1, 9)
    pressKey(SLOT_KEYS[slot], 0.02)
    task.wait(SLOT_EQUIP_DELAY)
    cur = char:FindFirstChildOfClass("Tool")
    if not cur then
        local tools = {}
        local bp = Players.LocalPlayer:FindFirstChild("Backpack")
        if bp then for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(tools, t) end end end
        local t = tools[slot]
        if t then pcall(function() hum:EquipTool(t) end) cur = t end
    end
    if cur then
        zackToolName = cur.Name
        log("Slot", string.format("slot %d equipado: %s", slot, cur.Name))
    else
        log("Slot", string.format("nenhuma ferramenta no slot %d", slot), true)
    end
end

-- teleporta UMA vez para o LADO do inimigo (pés no chão, colisão ligada) e fica parado batendo.
-- Se já está perto o bastante, não faz nada: sem seguir, sem teleporte repetido.
local function zackStick(enemy)
    local char = Players.LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not enemy.Parent then return false end

    local epos, er = enemyPos(enemy)
    zackLastEnemyPos = epos

    -- o mais perto possível: encosta no inimigo (metade da largura de cada um + folga),
    -- a menos que ZackQuest.Distance esteja definido
    local gap = math.min(er and er.Size.X or 2, 4) / 2 + hrp.Size.X / 2 + 0.2
    local dist = ZackQuest.Distance or gap

    -- já está perto o bastante: não mexe
    if (hrp.Position - epos).Magnitude <= dist + ZackQuest.Reposition then
        return true
    end

    -- sem noclip
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and ZACK_COLLIDE[part.Name] then part.CanCollide = true end
    end
    hrp.Anchored = false
    local chum = char:FindFirstChildOfClass("Humanoid")
    if chum then
        chum.PlatformStand = false
        pcall(function()
            if chum:GetState() == Enum.HumanoidStateType.StrafingNoPhysics then
                chum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)
    end

    -- lados do inimigo: direita primeiro, depois esquerda (o que tiver chão)
    local right = er and er.CFrame.RightVector or Vector3.new(1, 0, 0)
    right = Vector3.new(right.X, 0, right.Z)
    right = right.Magnitude > 0.01 and right.Unit or Vector3.new(1, 0, 0)

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = zackEnemiesRoot and { char, zackEnemiesRoot } or { char, enemy }
    local hip = chum and chum.HipHeight or 2
    if chum and chum.RigType == Enum.HumanoidRigType.R6 then hip = 2 end

    local stand
    for _, dir in ipairs({ right, -right }) do
        local side = epos + dir * dist
        local hit = workspace:Raycast(side + Vector3.new(0, 8, 0), Vector3.new(0, -300, 0), params)
        if hit then
            stand = Vector3.new(side.X, hit.Position.Y + hrp.Size.Y / 2 + hip + 0.05, side.Z)
            break
        end
    end
    stand = stand or Vector3.new(epos.X + right.X * dist, epos.Y, epos.Z + right.Z * dist)

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.CFrame = CFrame.lookAt(stand, Vector3.new(epos.X, stand.Y, epos.Z))
    log("Zack", "teleporte para o lado de " .. enemy.Name)
    return true
end

-- um "ataque": todos os métodos sem precisar do jogador clicar
local function zackHit(enemy, cds)
    if autoClickPausedByPanel then return end
    local previousAutoLock = autoInputLock
    autoInputLock = true
    local function stopIfPaused()
        if autoClickPausedByPanel then
            autoInputLock = previousAutoLock
            return true
        end
        return false
    end
    if fireclickdetector then
        for _, cd in ipairs(cds) do
            if stopIfPaused() then return end
            pcall(fireclickdetector, cd)
        end
    end
    if stopIfPaused() then return end
    local char = Players.LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then
        if stopIfPaused() then return end
        pcall(function() tool:Activate() end)
        if stopIfPaused() then return end
        if firesignal then pcall(firesignal, tool.Activated) end
    end
    if stopIfPaused() then return end
    autoInputLock = previousAutoLock
end

runZackQuest = function(alive, status)
    local target, attacked = nil, false
    local cds = {}
    local goneSince

    local function registerKill()
        if target and attacked and not zackAlive(target) then
            QuestState.kills += 1
            log("Quest", string.format("inimigo morto: %d/%d", QuestState.kills, QuestState.total))
            target, attacked = nil, false
        end
    end

    local ok, err = pcall(function()
        while alive() do
            while alive() and autoClickPausedByPanel do task.wait(0.05) end
            if not alive() then return end
            registerKill()

            local cur, total, text = getQuestProgress()
            if total and total > 0 then QuestState.total = total end
            if text then QuestState.text = text end

            -- terminou?
            if QuestState.kills >= QuestState.total then
                log("Quest", "meta atingida pela contagem do script")
                return
            end
            if cur and total and cur >= total and QuestState.kills > 0 then
                log("Quest", "interface mostra missão completa")
                return
            end
            -- a janela "Repetir Missão" apareceu: a missão acabou, devolve na hora para aceitar
            if AutoAccept.Enabled and QuestState.npcDone and repeatAcceptShown() then
                log("Quest", "janela Repetir Missão apareceu")
                return
            end
            if questUiShown() then
                goneSince = nil
            else
                goneSince = goneSince or os.clock()
                if os.clock() - goneSince >= 3 then
                    log("Quest", "missão sumiu da tela, considerando encerrada")
                    return
                end
            end

            status(T("Enemies left") .. ": " .. math.max(QuestState.total - QuestState.kills, 0))
            zackEnsureSlot()

            if not zackAlive(target) then
                local name = zackEnemyName(text or QuestState.text)
                target, attacked = zackNearest(name), false
                if not target then
                    status(T("No enemy found"))
                    if zackLastEnemyPos then
                        -- descarregou (StreamingEnabled): vai até onde viu o último e espera carregar
                        teleportTo(zackLastEnemyPos, 3)
                        pcall(function() Players.LocalPlayer:RequestStreamingAround(zackLastEnemyPos) end)
                    else
                        log("Zack", "nenhum '" .. name .. "' carregado; chegue perto deles uma vez", true)
                    end
                    task.wait(0.5)
                    continue
                end
                cds = enemyClickDetectors(target)
            end

            -- rajada: N cliques, um a cada ZackQuest.Interval segundos (grudado no inimigo)
            for _ = 1, ZackQuest.Clicks do
                if not alive() then return end
                if autoClickPausedByPanel then break end
                if not zackAlive(target) then break end
                zackStick(target)
                zackHit(target, cds)
                attacked = true
                local w = 0
                while w < universalAttackInterval() and alive() and not autoClickPausedByPanel and zackAlive(target) do
                    zackStick(target)
                    w += RunService.Heartbeat:Wait()
                end
            end
            registerKill()

            -- espera entre rajadas (continua grudado); se ele morreu, segue direto pro próximo
            if target then
                local waited = 0
                while waited < universalBurstInterval() and alive() and not autoClickPausedByPanel and zackAlive(target) do
                    zackStick(target)
                    waited += RunService.Heartbeat:Wait()
                end
                registerKill()
            end
        end
    end)

    if not ok then log("Zack", "erro no combate: " .. tostring(err), true) end
end

