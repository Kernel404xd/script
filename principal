            if teleportTo(jaquinPosition, 3) then
                pcall(function() Players.LocalPlayer:RequestStreamingAround(jaquinPosition) end)
                task.wait(1.0)
            end
        else
            log("Boss", "posição da Jaquin ainda não está salva; chegue perto dela uma vez para registrar", true)
        end
