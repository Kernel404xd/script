-- Busca dedicada porque Dual Swordsman pode usar um rig com Humanoid/RootPart aninhados.
DualOrbFarm.FindBoss = function(logDiagnostics)
    local world = workspace:FindFirstChild("World")
    local playability = world and world:FindFirstChild("Playability")
    local root = playability and playability:FindFirstChild("Enemys")
    if not root then
        if logDiagnostics then log("DualOrb", "Workspace.World.Playability.Enemys não existe", true) end
        return nil
    end

    local wanted = "dual swordsman"
    local character = Players.LocalPlayer and Players.LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local best, bestDistance, exactBest
    local loadedNames = {}
    local function inspect(model)
        if not model:IsA("Model") then return end
        if #loadedNames < 30 then table.insert(loadedNames, model.Name) end
        local normalized = normName(model.Name)
        if not normalized:find(wanted, 1, true) then return end
        local humanoid = model:FindFirstChildOfClass("Humanoid")
            or model:FindFirstChildWhichIsA("Humanoid", true)
        local body = model:FindFirstChild("HumanoidRootPart", true)
            or model.PrimaryPart
            or model:FindFirstChildWhichIsA("BasePart", true)
        if not body or (humanoid and humanoid.Health <= 0) then return end
        local distance = hrp and (enemyPos(model) - hrp.Position).Magnitude or 0
        local exact = normalized == wanted
        if not best or (exact and not exactBest) or (exact == exactBest and distance < bestDistance) then
            best, bestDistance, exactBest = model, distance, exact
        end
    end
    if root:IsA("Model") then inspect(root) end
    for _, obj in ipairs(root:GetDescendants()) do inspect(obj) end

    if best then
        if logDiagnostics then
            log("DualOrb", string.format("Dual Swordsman detectado: %s (%.0f studs)", best:GetFullName(), bestDistance or 0))
        end
    elseif logDiagnostics then
        log("DualOrb", "Dual Swordsman não encontrado. Models em Enemys: "
            .. (#loadedNames > 0 and table.concat(loadedNames, ", ") or "nenhum"), true)
    end
    return best
end

