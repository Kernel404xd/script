local function T(text)
    local lang = Config.Language
    if lang == "en" then return text end
    local entry = Dict[text]
    return (entry and entry[lang]) or text
end

local function loc(label, text, prefix)
    local fn = function() label.Text = (prefix or "") .. T(text) end
    fn()
    table.insert(langBinds, fn)
end

local function setLanguage(code)
    Config.Language = code
    for _, fn in ipairs(langBinds) do pcall(fn) end
    for _, fn in ipairs(themed) do pcall(fn) end
end

