            bst.Color = Theme.Stroke
        end)
    end
    local track = create("Frame", {
        Size = UDim2.fromOffset(40, 21), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = Theme.Off, Parent = row,
    }, { corner(11) })
    local glow = stroke(Theme.Accent, 1.5, 1)
    glow.Parent = track
    local knob = create("Frame", {
        Size = UDim2.fromOffset(15, 15), Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = Theme.Text, Parent = track,
    }, { corner(8) })

    local obj = {}
    local function render(animate)
        local pos = state and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        local col = state and Theme.Accent or Theme.Off
        local txt = state and Theme.Text or Theme.SubText
        local gl = state and 0.45 or 1
        glow.Color = Theme.AccentLite
        knob.BackgroundColor3 = Theme.Text
