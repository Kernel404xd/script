    function FruitFeature.runEsp(token)
        while FruitFeature.EspEnabled and FruitFeature.EspToken == token do
            local dropped = FruitFeature.findDroppedTools()
            local character = Players.LocalPlayer and Players.LocalPlayer.Character
            local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
            local seen = {}
            local count = 0
            if dropped then
                for _, obj in ipairs(dropped:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Name == "Handle" then
                        local prompt = FruitFeature.getPrompt(obj)
                        if prompt then
                            local fruitName = tostring(prompt.ObjectText or ""):gsub("^%s+", ""):gsub("%s+$", "")
                            if fruitName == "" then fruitName = "Fruta" end
                            FruitFeature.addMarker(obj, fruitName)
                            seen[obj] = true
                            count += 1
                            local marker = FruitFeature.Markers[obj]
                            local label = marker and marker:FindFirstChild("FruitLabel")
                            if label and playerRoot then
                                label.Text = string.format("%s | %d studs", fruitName, math.floor((playerRoot.Position - obj.Position).Magnitude + 0.5))
                            elseif label then
                                label.Text = fruitName .. " | -- studs"
                            end
                        end
                    end
                end
            end
            for handle, marker in pairs(FruitFeature.Markers) do
                if not seen[handle] or not handle.Parent then
                    if marker and marker.Parent then marker:Destroy() end
                    FruitFeature.Markers[handle] = nil
                end
            end
            FruitFeature.Status:SetText(dropped and ("Frutas: " .. count) or "DroppedTools não encontrada")
            task.wait(0.25)
        end
        FruitFeature.clearMarkers()
        FruitFeature.Status:SetText("Desativado")
    end

    FruitFeature.Section:AddToggle({
