task.spawn(function()
    while Window.Gui and Window.Gui.Parent do
        local changed = false
        for _, cfg in ipairs(Config._QuestNpcPositionTargets) do
            local current = workspace
            for _, segment in ipairs(cfg.Path or {}) do
                local nextObject = current:FindFirstChild(segment)
                if not nextObject then
                    local wanted = string.lower(tostring(segment))
                    for _, child in ipairs(current:GetChildren()) do
                        if string.lower(child.Name) == wanted then nextObject = child break end
                    end
                end
                if not nextObject then current = nil break end
                current = nextObject
            end
            if current then
                local wantedNpc = string.lower(tostring(cfg.Name))
                for _, model in ipairs(current:GetDescendants()) do
                    if model:IsA("Model") and string.lower(model.Name) == wantedNpc then
                        local part = model:FindFirstChild("HumanoidRootPart", true)
                            or model:FindFirstChildWhichIsA("BasePart", true)
                        if part then
                            local key = Config._NpcPosStorageKey(cfg.Name, cfg.Path)
                            local old = Config._DecodeNpcPos(savedNpcPos[key]) or Config._DecodeNpcPos(savedNpcPos[cfg.Name])
                            local pos = part.Position
                            if not savedNpcPos[key] or not old or (old - pos).Magnitude >= 3 then
                                savedNpcPos[key] = { pos.X, pos.Y, pos.Z }
                                changed = true
                            end
                        end
                    end
                end
            end
        end
        if changed and typeof(writefile) == "function" then
            pcall(function() writefile(NPC_POS_FILE, HttpService:JSONEncode(savedNpcPos)) end)
        end
        task.wait(3)
    end
end)

