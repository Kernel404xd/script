        Callback = function(enabled) PlayerFeatures.setNoclip(enabled) end,
    })

    PlayerFeatures.FlyEnabled = false
    PlayerFeatures.FlySpeed = 60
    PlayerFeatures.FlyKeys = {}
    PlayerFeatures.FlyConnection = nil
    PlayerFeatures.FlyVelocity = nil
    PlayerFeatures.FlyGyro = nil
    PlayerFeatures.FlyHumanoid = nil
    PlayerFeatures.FlyOriginalAutoRotate = nil
    PlayerFeatures.FlyOriginalPlatformStand = nil

    function PlayerFeatures.stopFly()
        PlayerFeatures.FlyEnabled = false
        if PlayerFeatures.FlyConnection then
            PlayerFeatures.FlyConnection:Disconnect()
            PlayerFeatures.FlyConnection = nil
        end
        if PlayerFeatures.FlyVelocity then PlayerFeatures.FlyVelocity:Destroy(); PlayerFeatures.FlyVelocity = nil end
        if PlayerFeatures.FlyGyro then PlayerFeatures.FlyGyro:Destroy(); PlayerFeatures.FlyGyro = nil end
        local humanoid = PlayerFeatures.FlyHumanoid
        if humanoid and humanoid.Parent then
            if PlayerFeatures.FlyOriginalAutoRotate ~= nil then humanoid.AutoRotate = PlayerFeatures.FlyOriginalAutoRotate end
            if PlayerFeatures.FlyOriginalPlatformStand ~= nil then humanoid.PlatformStand = PlayerFeatures.FlyOriginalPlatformStand end
        end
        PlayerFeatures.FlyHumanoid = nil
        PlayerFeatures.FlyOriginalAutoRotate = nil
        PlayerFeatures.FlyOriginalPlatformStand = nil
        table.clear(PlayerFeatures.FlyKeys)
    end

    function PlayerFeatures.startFly()
        PlayerFeatures.stopFly()
        local character = Players.LocalPlayer.Character
        local root = PlayerFeatures.getRoot(character)
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then return end

        PlayerFeatures.FlyEnabled = true
        PlayerFeatures.FlyHumanoid = humanoid
        PlayerFeatures.FlyOriginalAutoRotate = humanoid.AutoRotate
        PlayerFeatures.FlyOriginalPlatformStand = humanoid.PlatformStand
        humanoid.AutoRotate = false
        humanoid.PlatformStand = true

        local velocity = Instance.new("BodyVelocity")
        velocity.Name = "Kernel404FlightVelocity"
        velocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        velocity.P = 1e4
        velocity.Velocity = Vector3.zero
        velocity.Parent = root
        PlayerFeatures.FlyVelocity = velocity

        local gyro = Instance.new("BodyGyro")
        gyro.Name = "Kernel404FlightGyro"
        gyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        gyro.P = 1e4
        gyro.CFrame = workspace.CurrentCamera.CFrame
        gyro.Parent = root
        PlayerFeatures.FlyGyro = gyro

        PlayerFeatures.FlyConnection = RunService.Heartbeat:Connect(function()
            if not PlayerFeatures.FlyEnabled or not root.Parent or not velocity.Parent or not gyro.Parent then
                PlayerFeatures.stopFly()
                return
            end
            local camera = workspace.CurrentCamera
            if not camera then velocity.Velocity = Vector3.zero; return end
            local look = camera.CFrame.LookVector
            local right = camera.CFrame.RightVector
            local direction = Vector3.zero
            if PlayerFeatures.FlyKeys[Enum.KeyCode.W] then direction += look end
            if PlayerFeatures.FlyKeys[Enum.KeyCode.S] then direction -= look end
            if PlayerFeatures.FlyKeys[Enum.KeyCode.D] then direction += right end
            if PlayerFeatures.FlyKeys[Enum.KeyCode.A] then direction -= right end
            if PlayerFeatures.FlyKeys[Enum.KeyCode.Space] then direction += Vector3.yAxis end
            if PlayerFeatures.FlyKeys[Enum.KeyCode.LeftControl] then direction -= Vector3.yAxis end
            velocity.Velocity = direction.Magnitude > 0 and direction.Unit * PlayerFeatures.FlySpeed or Vector3.zero
            local flatLook = Vector3.new(look.X, 0, look.Z)
            if flatLook.Magnitude > 0.01 then gyro.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook.Unit) end
        end)
    end

    UserInputService.InputBegan:Connect(function(input, processed)
        if PlayerFeatures.FlyEnabled and not processed and input.UserInputType == Enum.UserInputType.Keyboard then
            PlayerFeatures.FlyKeys[input.KeyCode] = true
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Keyboard then
            PlayerFeatures.FlyKeys[input.KeyCode] = nil
        end
    end)
    Players.LocalPlayer.CharacterAdded:Connect(function()
        if PlayerFeatures.FlyEnabled then
            task.wait(0.4)
            if PlayerFeatures.FlyEnabled then PlayerFeatures.startFly() end
        end
    end)
    PlayerFeatures.Section:AddToggle({
        Name = "Fly (WASD / Space / Ctrl)",
        Callback = function(enabled)
            if enabled then PlayerFeatures.startFly() else PlayerFeatures.stopFly() end
        end,
    })
    PlayerFeatures.Section:AddSlider({
        Name = "Flight Speed",
        Min = 10,
        Max = 300,
        Default = PlayerFeatures.FlySpeed,
        Callback = function(value) PlayerFeatures.FlySpeed = value end,
    })

    function PlayerFeatures.clearMarkers()
        for target, marker in pairs(PlayerFeatures.Markers) do
            if marker and marker.Parent then marker:Destroy() end
            PlayerFeatures.Markers[target] = nil
        end
    end

    function PlayerFeatures.getRoot(character)
        return character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head"))
    end

    function PlayerFeatures.updateMarker(target, root, distance)
        local marker = PlayerFeatures.Markers[target]
        if not marker or not marker.Parent then
            local localPlayer = Players.LocalPlayer
            local playerGui = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
            if not playerGui then return end
            marker = Instance.new("BillboardGui")
            marker.Name = "Kernel404PlayerESP"
            marker.AlwaysOnTop = true
            marker.LightInfluence = 0
            marker.Size = UDim2.fromOffset(210, 34)
            marker.StudsOffset = Vector3.new(0, 3, 0)
            marker.MaxDistance = 3000
            marker.Parent = playerGui
            local label = Instance.new("TextLabel")
            label.Name = "PlayerLabel"
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundColor3 = Color3.fromRGB(20, 16, 32)
            label.BackgroundTransparency = 0.18
            label.BorderSizePixel = 0
            label.TextColor3 = Color3.fromRGB(235, 245, 255)
            label.TextStrokeTransparency = 0.25
            label.Font = Enum.Font.GothamBold
            label.TextSize = 13
            label.Parent = marker
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 7)
            corner.Parent = label
            PlayerFeatures.Markers[target] = marker
        end
        marker.Adornee = root
        local label = marker:FindFirstChild("PlayerLabel")
        if label then label.Text = string.format("%s | %d studs", target.Name, math.floor(distance + 0.5)) end
    end

    function PlayerFeatures.runEsp(token)
        while PlayerFeatures.EspEnabled and PlayerFeatures.EspToken == token do
            local localPlayer = Players.LocalPlayer
            local localRoot = PlayerFeatures.getRoot(localPlayer and localPlayer.Character)
            local seen = {}
            if localRoot then
                for _, target in ipairs(Players:GetPlayers()) do
                    if target ~= localPlayer then
                        local root = PlayerFeatures.getRoot(target.Character)
                        local humanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
                        if root and (not humanoid or humanoid.Health > 0) then
                            PlayerFeatures.updateMarker(target, root, (root.Position - localRoot.Position).Magnitude)
                            seen[target] = true
                        end
                    end
                end
            end
            for target, marker in pairs(PlayerFeatures.Markers) do
                if not seen[target] or target.Parent ~= Players then
                    if marker and marker.Parent then marker:Destroy() end
                    PlayerFeatures.Markers[target] = nil
                end
            end
            task.wait(0.25)
        end
        PlayerFeatures.clearMarkers()
    end

    PlayerFeatures.Section:AddToggle({
        Name = "Player ESP",
        Callback = function(enabled)
            PlayerFeatures.EspEnabled = enabled
            PlayerFeatures.EspToken += 1
            if enabled then
                task.spawn(PlayerFeatures.runEsp, PlayerFeatures.EspToken)
            else
                PlayerFeatures.clearMarkers()
            end
        end,
    })
end

