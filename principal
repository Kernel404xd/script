-- Bloqueia cliques automáticos sobre a janela principal E sobre os HUDs de cancelar.
-- Assim um clique de ataque não pode pressionar o botão DESATIVAR por coincidência.
local function pointHitsKernelPanel(point, inset)
    local guiParent = getGuiParent()
    local panelGui = guiParent:FindFirstChild("Kernel404")
    local root = panelGui and panelGui:FindFirstChild("Root")
    local function inside(frame, p)
        if not frame or not frame:IsA("GuiObject") or hiddenReason(frame) then return false end
        local pos, size = frame.AbsolutePosition, frame.AbsoluteSize
        return p.X >= pos.X and p.X <= pos.X + size.X
            and p.Y >= pos.Y and p.Y <= pos.Y + size.Y
    end
    local points = { point }
    if inset then table.insert(points, point + inset) end
    for _, p in ipairs(points) do
        if inside(root, p) then return true end
        for _, name in ipairs({ "ArmamentCrystalHotkeyHint", "BananaFarmHotkeyHint" }) do
            local hud = guiParent:FindFirstChild(name, true)
            if inside(hud, p) then return true end
        end
    end
    return false
end

-- Clica no NPC no mundo 3D: mira a câmera nele se necessário e envia um clique real.
local function clickNpcOnScreen(model, allowPanelPause)
    if (autoClickPausedByPanel and not allowPanelPause) or not model or not model.Parent then return false end
    if Config._EnsureClickerZoom then Config._EnsureClickerZoom() end
    local camera = workspace.CurrentCamera
    if not camera then return false end

    local part = model:FindFirstChild("Head", true)
        or model:FindFirstChild("HumanoidRootPart", true)
        or model:FindFirstChildWhichIsA("BasePart", true)
    local targetPos = part and part.Position or npcPosition(model)
    local oldCameraCFrame = camera.CFrame
    local changedCamera = false
    local screenPos, onScreen = camera:WorldToViewportPoint(targetPos)
    if not onScreen or screenPos.Z <= 0 then
        camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetPos)
        changedCamera = true
        task.wait(0.12)
        screenPos, onScreen = camera:WorldToViewportPoint(targetPos)
    end
    if not onScreen or screenPos.Z <= 0 then
        if changedCamera then camera.CFrame = oldCameraCFrame end
        log("Click", "alvo fora da tela; não foi possível clicar", true)
        return false
    end

    local inset = GuiService:GetGuiInset()
    local x, y = screenPos.X + inset.X, screenPos.Y + inset.Y
    local clickPoint = Vector2.new(x, y)
    if pointHitsKernelPanel(clickPoint) then
        if changedCamera then camera.CFrame = oldCameraCFrame end
        log("Click", "clique de tela ignorado: o alvo está atrás do painel", true)
        return false
    end

    -- Nunca esconde a janela: se o alvo está fora do painel, o clique vai ao jogo;
    -- se está sob o painel, o clique foi ignorado acima para preservar os controles.
    local ok, err = pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.08)
        vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    task.wait(0.05)
    if changedCamera then camera.CFrame = oldCameraCFrame end

    if ok then
        log("Click", string.format("clique real no alvo %s em (%.0f, %.0f)", model:GetFullName(), x, y))
        return true
    end
    log("Click", "clique real no alvo falhou: " .. tostring(err), true)
    return false
end

-- Tenta primeiro ClickDetector do próprio NPC e depois um clique real na tela.
local function clickNpc(model, allowPanelPause)
    if (autoClickPausedByPanel and not allowPanelPause) or not model or not model.Parent then return false end
    for _, detector in ipairs(model:GetDescendants()) do
        if detector:IsA("ClickDetector") then
            if typeof(fireclickdetector) == "function" then
                local ok = pcall(fireclickdetector, detector)
                if ok then
                    log("Click", "ClickDetector acionado: " .. detector:GetFullName())
                    return true
                end
            end
            if typeof(firesignal) == "function" then
                local ok = pcall(function() firesignal(detector.MouseClick, Players.LocalPlayer) end)
                if ok then
                    log("Click", "MouseClick do ClickDetector acionado: " .. detector:GetFullName())
                    return true
                end
            end
        end
    end
    return clickNpcOnScreen(model, allowPanelPause)
end

-- attempt 1: fireproximityprompt (se não houver prompt, clique real)
-- attempt 2: clique real na tela
-- attempt 3: fireproximityprompt + clique real
local function interactWith(model, attempt, allowPanelPause)
    attempt = attempt or 1

    -- espera o prompt existir (o NPC pode demorar a carregar depois do teleporte)
    local prompt, count
    for _ = 1, (attempt == 1) and 30 or 1 do
        prompt, count = findNpcPrompt(model)
        if prompt then break end
        task.wait(0.05)
    end

    local acted = false
    if attempt ~= 2 then
        if prompt then
            if count and count > 1 then
                log("Interact", string.format("%d ProximityPrompts perto de %s, usando %s",
                    count, model.Name, prompt:GetFullName()))
            end
            acted = firePrompt(prompt) or acted
        else
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("ClickDetector") and typeof(fireclickdetector) == "function" then
                    fireclickdetector(d)
                    log("Interact", "fireclickdetector em " .. d:GetFullName())
                    acted = true
                    break
                end
            end
        end
    end

    if attempt ~= 1 or not acted then
        if clickNpc(model, allowPanelPause) then acted = true end
    end
    if acted then return true end

    -- último recurso: mostra a estrutura e clica diretamente no NPC da quest
    local interact = model:FindFirstChild("Interact", true)
    local classes = {}
    if interact then
        for _, d in ipairs(interact:GetDescendants()) do
            if #classes < 15 then table.insert(classes, d.Name .. " [" .. d.ClassName .. "]") end
        end
    end
    log("Interact", string.format("não consegui interagir com %s. 'Interact' = %s%s -> tentando clique real no NPC",
        model:GetFullName(),
        interact and interact.ClassName or "não existe",
        #classes > 0 and (" com: " .. table.concat(classes, ", ")) or ""), true)

    if not npcDumped[model] then
        npcDumped[model] = true
        local out = {}
        dumpTree(model, 0, 4, out)
        print("[Kernel404][Dump] estrutura de " .. model:GetFullName())
        for _, line in ipairs(out) do print("[Kernel404][Dump] " .. line) end
    end
    if allowPanelPause then return clickNpcOnScreen(model, true) end
    return pressKey(Enum.KeyCode.E)
end

-- imprime no console (F9) tudo que existe dentro do NPC (para achar o que interagir)
local function dumpNpc(cfg)
    cfg = cfg or QuestNpc
    local root = resolvePath(workspace, cfg.Path, "NPC")
    if not root then
        print("[Kernel404][Dump] pasta do NPC não encontrada (veja o aviso [NPC] acima)")
        return
    end
    local found = 0
    for _, d in ipairs(root:GetDescendants()) do
        if cfg.Name and d.Name == cfg.Name then
            found += 1
            local out = {}
            dumpTree(d, 0, 4, out)
            print(string.format("[Kernel404][Dump] #%d %s [%s]", found, d:GetFullName(), d.ClassName))
            for _, line in ipairs(out) do print("[Kernel404][Dump] " .. line) end
        end
    end
    if found == 0 then
        print(string.format("[Kernel404][Dump] nenhum '%s' em %s. Conteúdo da pasta:",
            tostring(cfg.Name), root:GetFullName()))
        local out = {}
        dumpTree(root, 0, 3, out)
        for _, line in ipairs(out) do print("[Kernel404][Dump] " .. line) end
    end
end

