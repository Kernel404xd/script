local function safe(cb, ...)
    if typeof(cb) == "function" then
        local ok, err = pcall(cb, ...)
        if not ok then warn("[Kernel404] Callback error: " .. tostring(err)) end
    end
end

----------------------------------------------------------------------
-- LOG / DEBUG  (prints no console F9 para achar erros)
-- liga/desliga em Config > Janela > "Debug prints"
----------------------------------------------------------------------
local lastLog = {}

-- mensagem repetida em sequência (mesma tag) só aparece uma vez, para não encher o console
local function log(tag, msg, isWarn)
    if not Config.Debug then return end
    msg = tostring(msg)
    if lastLog[tag] == msg then return end
    lastLog[tag] = msg
    local line = string.format("[Kernel404][%s] %s", tag, msg)
    if isWarn then warn(line) else print(line) end
end

-- roda uma função e, se der erro, mostra a mensagem + traceback (sempre, mesmo com Debug desligado)
local function guard(tag, fn)
    return function(...)
        while true do
            local ok, err = xpcall(fn, function(e)
                return tostring(e) .. "\n" .. debug.traceback()
            end, ...)
            if ok then return end
            warn(string.format("[Kernel404][%s] ERRO (tentando continuar): %s", tag, tostring(err)))
            task.wait(1)
        end
    end
end

-- segue um caminho de nomes e avisa exatamente onde ele quebrou
local function resolvePath(root, names, tag)
    local obj = root
    for _, n in ipairs(names) do
        local nxt = obj:FindFirstChild(n)
        if not nxt then
            log(tag, string.format("caminho quebrou em '%s' (dentro de %s)", n, obj:GetFullName()), true)
            return nil
        end
        obj = nxt
    end
    return obj
end

local function dumpTree(obj, depth, maxDepth, out)
    if #out >= 400 then return end
    table.insert(out, string.rep("  ", depth) .. obj.Name .. " [" .. obj.ClassName .. "]")
    if depth < maxDepth then
        for _, c in ipairs(obj:GetChildren()) do dumpTree(c, depth + 1, maxDepth, out) end
    end
end

local function getGuiParent()
    if typeof(gethui) == "function" then
        local ok, ui = pcall(gethui)
        if ok and ui then return ui end
    end
    local ok = pcall(function() return CoreGui.Name end)
    if ok then return CoreGui end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function resolveLogo()
    if Config.LogoId ~= "" then
        local id = tostring(Config.LogoId)
        if not id:find("rbxassetid://") then id = "rbxassetid://" .. id end
        return id
    end
    if Config.LogoFile ~= "" and typeof(isfile) == "function" and typeof(getcustomasset) == "function" then
        local ok, asset = pcall(function()
            if isfile(Config.LogoFile) then return getcustomasset(Config.LogoFile) end
        end)
        if ok and asset then return asset end
    end
    return nil
end

local function nameRich()
    return string.format('Kernel<font color="#%s">404</font>', Theme.Accent:ToHex())
end

-- logo (imagem ou texto reserva), sempre em uma linha só — usada só no loading
