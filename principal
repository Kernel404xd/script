local GLITCH_TEXTS = { "4Ø4", "4O4", "4#4", "/04", "40/", "4@4", "4_4", "#0#" }

local function createGlitchName(parent, textSize, position, anchor, zindex)
    zindex = zindex or 1
    local font = Theme.FontBold
    local bounds = Vector2.new(1000, 200)
    local wK = TextService:GetTextSize("Kernel", textSize, font, bounds).X
    local w4 = TextService:GetTextSize("404", textSize, font, bounds).X + 6
    local h = textSize + 8

    local holder = create("Frame", {
        Name = "GlitchName", Size = UDim2.fromOffset(wK + w4, h), Position = position,
        AnchorPoint = anchor or Vector2.new(0, 0), BackgroundTransparency = 1, ZIndex = zindex, Parent = parent,
    })
    local function mk(text, x, w, color, z)
        return create("TextLabel", {
            Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(x, 0), BackgroundTransparency = 1,
            Text = text, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Left,
            Font = font, TextSize = textSize, ZIndex = z, Parent = holder,
        })
    end
    local kernel = mk("Kernel", 0, wK, WHITE, zindex)
    local ghostA = mk("404", wK, w4, Color3.fromRGB(80, 210, 255), zindex)
    local ghostB = mk("404", wK, w4, Color3.fromRGB(255, 60, 170), zindex)
    local main   = mk("404", wK, w4, Theme.Accent, zindex + 1)
    ghostA.TextTransparency, ghostB.TextTransparency = 1, 1
    return { Holder = holder, Kernel = kernel, Main = main, GhostA = ghostA, GhostB = ghostB, X = wK }
end

local function startNameGlitch(g, alive)
    task.spawn(function()
        local x = g.X
        while alive() do
            task.wait(math.random(25, 90) / 100)
            if not alive() then break end
            for i = 1, math.random(3, 8) do
                local txt = GLITCH_TEXTS[math.random(#GLITCH_TEXTS)]
                g.Main.Text, g.GhostA.Text, g.GhostB.Text = txt, txt, txt
                g.GhostA.Position = UDim2.fromOffset(x + math.random(-5, 1), math.random(-2, 2))
                g.GhostB.Position = UDim2.fromOffset(x + math.random(-1, 5), math.random(-2, 2))
                g.GhostA.TextTransparency, g.GhostB.TextTransparency = 0.2, 0.2
                g.Main.Position = UDim2.fromOffset(x + math.random(-2, 2), 0)
                g.Main.TextTransparency = (math.random() < 0.3) and 0.5 or 0
                g.Kernel.Position = UDim2.fromOffset((math.random() < 0.25) and math.random(-1, 1) or 0, 0)
                task.wait(0.04)
            end
            g.Main.Text, g.GhostA.Text, g.GhostB.Text = "404", "404", "404"
            g.GhostA.Position, g.GhostB.Position = UDim2.fromOffset(x, 0), UDim2.fromOffset(x, 0)
            g.GhostA.TextTransparency, g.GhostB.TextTransparency = 1, 1
            g.Main.Position, g.Kernel.Position = UDim2.fromOffset(x, 0), UDim2.fromOffset(0, 0)
            g.Main.TextTransparency = 0
        end
    end)
end

