            tween(knob, { Position = pos }, 0.2, Enum.EasingStyle.Back)
            tween(track, { BackgroundColor3 = col })
            tween(label, { TextColor3 = txt })
            tween(glow, { Transparency = gl })
        else
            knob.Position, track.BackgroundColor3, label.TextColor3, glow.Transparency = pos, col, txt, gl
        end
    end
    function obj:Set(v, silent)
            state = v and true or false
        render(true)
        if not silent then safe(opts.Callback, state) end
    end
    function obj:Get() return state end
    function obj:SetBadge(text)
        if badge then badge.Text = tostring(text) end
    end

    row.MouseButton1Click:Connect(function()
        obj:Set(not state)
    end)
    bind(function() render(false) end)
    return obj
end

