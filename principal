----------------------------------------------------------------------
-- AUTO ARMAMENT CRYSTAL: procura Mad Chip no inventário e aceita a quest.
----------------------------------------------------------------------
local ArmamentCrystalFarm = {
    Enabled = false,
    Path = { "World", "IgnoreList", "Npcs", "Interactive", "WestIsland" },
    Name = "Mad Scientist",
    LastPos = recallNpcPos("Mad Scientist", { "World", "IgnoreList", "Npcs", "Interactive", "WestIsland" }),
    EnemyPath = { "World", "Playability", "Enemys" },
    BossName = "Beast",
}
local armamentCrystalToken = 0

local function findMadChipTool()
    local player = Players.LocalPlayer
    if not player then return nil end
    local playerGui = player:FindFirstChild("PlayerGui")
    for _, item in ipairs(player:GetDescendants()) do
        local isInventoryObject = item:IsA("Tool") or item:IsA("ValueBase")
            or item:IsA("Folder") or item:IsA("Configuration")
        local isPlayerGui = playerGui and item:IsDescendantOf(playerGui)
        local compactName = item.Name:lower():gsub("%s+", "")
        if isInventoryObject and not isPlayerGui and compactName:find("madchip", 1, true) == 1 then
            return item
        end
    end
    return nil
end

local function findArmamentCrystalBoss()
    local root = resolvePath(workspace, ArmamentCrystalFarm.EnemyPath, "ArmamentCrystal")
    if not root then return nil end
    local character = Players.LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local best, bestDistance
    local wanted = normName(ArmamentCrystalFarm.BossName)
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("Model") and normName(obj.Name):find(wanted, 1, true) then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local distance = hrp and (enemyPos(obj) - hrp.Position).Magnitude or 0
                if not bestDistance or distance < bestDistance then
                    best, bestDistance = obj, distance
                end
            end
        end
    end
    if best then log("ArmamentCrystal", "boss encontrado: " .. best:GetFullName()) end
    return best
end

local function acceptArmamentCrystalQuest(alive, status)
    if questUiShown() then
        local _, _, activeText = getQuestProgress()
        local activeLower = string.lower(activeText or "")
        if activeLower:find("beast", 1, true)
            or activeLower:find("armament", 1, true)
            or activeLower:find("crystal", 1, true) then
            status("Quest already active")
            return true
        end
        status("Other quest active")
        log("ArmamentCrystal", "há outra missão ativa; não vou tratar como missão do Beast", true)
        return false
    end

    status("Finding Mad Scientist")
    local target, pos = findNpcTarget(ArmamentCrystalFarm)
    if not target then return false end
    if not teleportTo(pos, 3) then
        status("Character not found")
        return false
    end
    task.wait(0.25)

    local yes
    for attempt = 1, 3 do
        if not alive() then return false end
        for clickIndex = 1, 3 do
            interactWith(target, attempt, true) -- clique no Mad Scientist mesmo com o painel aberto.
            if clickIndex < 3 then task.wait(0.2) end
        end
        yes = waitForYes(1.5, alive)
        if yes then break end
        log("ArmamentCrystal", "diálogo não abriu; clicando diretamente no Mad Scientist", true)
        clickNpcOnScreen(target, true)
        yes = waitForYes(1.2, alive)
        if yes then break end
    end
    if not (yes and alive()) then
        status("Yes button not found")
        return false
    end

    pressButton(yes)
    local elapsed = 0
    while elapsed < 2.5 and alive() do
        if questUiShown() then
            status("Quest accepted")
            log("ArmamentCrystal", "quest do Mad Scientist aceita")
            return true
        end
        task.wait(0.1)
        elapsed += 0.1
    end
    log("ArmamentCrystal", "Yes pressionado mas a quest não apareceu", true)
    return false
end

local function stopArmamentCrystalFarm()
    ArmamentCrystalFarm.Enabled = false
    armamentCrystalToken += 1
end

local function startArmamentCrystalFarm(onStatus)
    armamentCrystalToken += 1
    local mine = armamentCrystalToken
    ArmamentCrystalFarm.Enabled = true
    local function alive() return ArmamentCrystalFarm.Enabled and armamentCrystalToken == mine end
    local function status(text) if alive() then safe(onStatus, text) end end

    task.spawn(guard("ArmamentCrystal", function()
        local handledTool
        while alive() do
            local boss = findArmamentCrystalBoss()
            if boss then
                status("Killing Beast")
                -- Mesmo posicionamento e sequência de ataque dos farms de inimigos.
                killBananaEnemy(boss, alive)
            else
                local tool = findMadChipTool()
                if not tool then
                    handledTool = nil
                    status("Missing Mad Chip")
                elseif tool ~= handledTool then
                    status("Mad Chip found")
                    if acceptArmamentCrystalQuest(alive, status) then
                        handledTool = tool
                    end
                else
                    status("Waiting for Beast")
                end
                task.wait(0.5)
            end
        end
    end))
end

