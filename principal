    function FruitFeature.getFruitButton(actionName)
        local player = Players.LocalPlayer
        local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
        local interfaces = playerGui and playerGui:FindFirstChild("Interfaces")
        local frames = interfaces and interfaces:FindFirstChild("Frames")
        local physical = frames and frames:FindFirstChild("Physical Fruits")
        local eatFruit = physical and physical:FindFirstChild("EatFruit")
        local buttons = eatFruit and eatFruit:FindFirstChild("Buttons")
        local button = buttons and buttons:FindFirstChild(actionName)
        if button and (button:IsA("TextButton") or button:IsA("ImageButton")) then
            log("Fruit", "botão localizado: " .. button:GetFullName() .. " | classe=" .. button.ClassName .. " | visível=" .. tostring(not hiddenReason(button)))
            return button
        end
        log("Fruit", string.format("caminho incompleto para %s | PlayerGui=%s Interfaces=%s Frames=%s Physical Fruits=%s EatFruit=%s Buttons=%s",
            actionName, tostring(playerGui ~= nil), tostring(interfaces ~= nil), tostring(frames ~= nil),
            tostring(physical ~= nil), tostring(eatFruit ~= nil), tostring(buttons ~= nil)), true)
        return nil
    end

    function FruitFeature.waitFruitButton(actionName, token)
        local lastReason = "objeto ausente"
        for _ = 1, 40 do
            if not FruitFeature.PickEnabled or FruitFeature.PickToken ~= token then
                log("Fruit", "espera de botão cancelada pelo toggle/token")
                return nil
            end
            local button = FruitFeature.getFruitButton(actionName)
            if button then
                lastReason = hiddenReason(button) or ""
                if lastReason == "" then return button end
            end
            task.wait(0.1)
        end
        log("Fruit", "timeout aguardando botão " .. actionName .. "; último estado: " .. lastReason, true)
        return nil
    end

    function FruitFeature.clickFruitButton(button)
        if not button then log("Fruit", "click recusado: botão nil", true); return false end
        local reason = hiddenReason(button)
        if reason then log("Fruit", "click recusado: " .. reason, true); return false end
        return FruitFeature.withMenuHidden(function()
            log("Fruit", "acionando um único evento no botão: " .. button:GetFullName())
            if typeof(getconnections) == "function" then
                local clickConnections = getconnections(button.MouseButton1Click)
                local activatedConnections = getconnections(button.Activated)
                log("Fruit", string.format("sinais: MouseButton1Click=%d, Activated=%d", #clickConnections, #activatedConnections))
                local chosen = (#clickConnections > 0) and clickConnections or activatedConnections
                local signalName = (#clickConnections > 0) and "MouseButton1Click" or "Activated"
                if chosen[1] then
                    local ok, err = pcall(function() chosen[1]:Fire() end)
                    log("Fruit", "disparo único " .. signalName .. ": " .. tostring(ok) .. (err and (" | " .. tostring(err)) or ""), not ok)
                    return ok
                end
            end
            if typeof(firesignal) == "function" then
                local ok, err = pcall(firesignal, button.MouseButton1Click)
                log("Fruit", "firesignal único MouseButton1Click: " .. tostring(ok) .. (err and (" | " .. tostring(err)) or ""), not ok)
                if ok then return true end
            end
            local mouseOk, mouseErr = pcall(function()
                local input = game:GetService("VirtualInputManager")
                local inset = GuiService:GetGuiInset()
                local point = button.AbsolutePosition + button.AbsoluteSize / 2 + inset
                input:SendMouseButtonEvent(point.X, point.Y, 0, true, game, 0)
                task.wait(0.08)
                input:SendMouseButtonEvent(point.X, point.Y, 0, false, game, 0)
            end)
            log("Fruit", "clique VirtualInputManager no botão: " .. tostring(mouseOk) .. (mouseErr and (" | " .. tostring(mouseErr)) or ""), not mouseOk)
