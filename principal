-- SALVAR / CARREGAR CONFIG
----------------------------------------------------------------------
local function saveConfig()
    if typeof(writefile) ~= "function" then return end
    local data = { Colors = {}, Combat = {}, AutoSkills = {} }
    for k, c in pairs(Config.Colors) do data.Colors[k] = c:ToHex() end
    for k, v in pairs(Config.Combat or {}) do data.Combat[k] = v end
    for k, v in pairs(Config.AutoSkills or {}) do data.AutoSkills[k] = v end
    for _, k in ipairs(CUSTOM_KEYS) do data[k] = Config[k] end
    pcall(function() writefile(Config.SaveFile, HttpService:JSONEncode(data)) end)
end

local saveToken = 0
local function scheduleSave()
    saveToken += 1
    local mine = saveToken
    task.delay(0.6, function()
        if mine == saveToken then saveConfig() end
    end)
end

local function loadConfig()
    if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then return end
    local ok, data = pcall(function()
        if isfile(Config.SaveFile) then return HttpService:JSONDecode(readfile(Config.SaveFile)) end
    end)
    if not ok or type(data) ~= "table" then return end
    if type(data.Colors) == "table" then
        for k, hex in pairs(data.Colors) do
            if Config.Colors[k] ~= nil and type(hex) == "string" then
                local good, c = pcall(Color3.fromHex, hex)
                if good then Config.Colors[k] = c end
            end
        end
    end
    if type(data.Combat) == "table" then
        for k, v in pairs(data.Combat) do
            if Config.Combat[k] ~= nil and type(v) == type(Config.Combat[k]) then Config.Combat[k] = v end
        end
    end
    if type(data.AutoSkills) == "table" then
        for k, v in pairs(data.AutoSkills) do
            if Config.AutoSkills[k] ~= nil and type(v) == "boolean" then Config.AutoSkills[k] = v end
        end
    end
    for _, k in ipairs(CUSTOM_KEYS) do
        if data[k] ~= nil and type(data[k]) == type(Config[k]) then Config[k] = data[k] end
    end
end

----------------------------------------------------------------------
-- TEMA (calculado a partir de Config.Colors)
----------------------------------------------------------------------
local Theme = {
    Font      = Enum.Font.GothamMedium,
    FontBold  = Enum.Font.GothamBold,
    FontBlack = Enum.Font.GothamBlack,
}
local WHITE, BLACK = Color3.new(1, 1, 1), Color3.new(0, 0, 0)

local function rebuildTheme()
    local c = Config.Colors
    Theme.Accent     = c.Accent
    Theme.AccentLite = c.Accent:Lerp(WHITE, 0.38)
    Theme.AccentDark = c.Accent:Lerp(BLACK, 0.40)
    Theme.Aura       = c.Aura
    Theme.Background = c.Background
    Theme.Topbar     = c.Background:Lerp(c.Accent, 0.07):Lerp(WHITE, 0.02)
    Theme.Sidebar    = c.Background:Lerp(BLACK, 0.2)
    Theme.Black      = c.Background:Lerp(BLACK, 0.6)
    Theme.Panel      = c.Panel
    Theme.Element    = c.Panel:Lerp(WHITE, 0.05):Lerp(c.Accent, 0.14)
    Theme.Stroke     = c.Panel:Lerp(c.Accent, 0.45)
    Theme.Text       = c.Text
    Theme.SubText    = c.Text:Lerp(c.Background, 0.45)
    Theme.Off        = c.Panel:Lerp(WHITE, 0.12)
end

-- callbacks que reaplicam o tema / idioma
local themed, langBinds = {}, {}
local autoInputLock = false -- estado interno durante input automatizado
local autoClickPausedByPanel = true -- pausado enquanto o painel expandido está aberto

local function bind(fn)
    fn()
    table.insert(themed, fn)
end

local function applyTheme()
    rebuildTheme()
    for _, fn in ipairs(themed) do pcall(fn) end
end

local function colorize(obj, prop, key)
    bind(function() obj[prop] = Theme[key] end)
end

