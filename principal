local function listNpcModels(root, expectedName)
    local list = {}
    local function addModel(model)
        if not model:IsA("Model") then return end
        local hasRig = model:FindFirstChildOfClass("Humanoid") or model:FindFirstChild("HumanoidRootPart")
        local exactName = expectedName and string.lower(model.Name) == string.lower(tostring(expectedName))
        if hasRig or exactName then table.insert(list, model) end
    end
    if root:IsA("Model") then addModel(root) end
    for _, d in ipairs(root:GetDescendants()) do addModel(d) end
    return list
end

