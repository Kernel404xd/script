    function obj:Get() return selected end
    function obj:Refresh(newOptions) options = newOptions; build() end

    header.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)
    bind(build)
    return obj
end

function Section:AddSlider(opts)
    opts = opts or {}
    local min, max = opts.Min or 0, opts.Max or 100
    local value = math.clamp(opts.Default or min, min, max)

    local holder = create("Frame", {
        Size = UDim2.new(1, 0, 0, 42), BackgroundTransparency = 1, LayoutOrder = nextOrder(self), Parent = self.Container,
    })
    local label = create("TextLabel", {
        Size = UDim2.new(1, -50, 0, 18), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Font, TextSize = 13, Parent = holder,
    })
    loc(label, opts.Name or "Slider")
    local valueLabel = create("TextLabel", {
        Size = UDim2.new(0, 50, 0, 18), Position = UDim2.new(1, -50, 0, 0), BackgroundTransparency = 1,
        Text = tostring(value), TextColor3 = Theme.AccentLite, TextXAlignment = Enum.TextXAlignment.Right,
        Font = Theme.FontBold, TextSize = 12, Parent = holder,
    })
    local bar = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 8), Position = UDim2.new(0, 0, 0, 28), BackgroundColor3 = Theme.Off,
        Text = "", AutoButtonColor = false, Parent = holder,
    }, { corner(4) })
    local fill = create("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0, Parent = bar,
    }, { corner(4) })
    local fillGrad = create("UIGradient", { Parent = fill })
    local knob = create("Frame", {
        Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        BackgroundColor3 = Theme.Text, Parent = fill,
    }, { corner(7) })
    local kst = stroke(Theme.Accent, 2)
    kst.Parent = knob

    bind(function()
        label.TextColor3, valueLabel.TextColor3 = Theme.SubText, Theme.AccentLite
        bar.BackgroundColor3, knob.BackgroundColor3, kst.Color = Theme.Off, Theme.Text, Theme.Accent
        fillGrad.Color = ColorSequence.new(Theme.AccentDark, Theme.AccentLite)
    end)

    local obj = {}
    function obj:Set(v, silent)
            value = math.clamp(math.floor(v + 0.5), min, max)
        valueLabel.Text = tostring(value)
        tween(fill, { Size = UDim2.new((value - min) / (max - min), 0, 1, 0) }, 0.06)
        if not silent then safe(opts.Callback, value) end
    end
    function obj:Get() return value end

    local dragging = false
    local function update(x)
        obj:Set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1))
    end
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input.Position.X)
        end
    end)
    return obj
end

-- seletor de cor (H / S / V + HEX)
function Section:AddColorPicker(opts)
    opts = opts or {}
    local color = opts.Default or WHITE
    local h, s, v = color:ToHSV()
    local open = false
    local PH = 124

    local holder = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
        LayoutOrder = nextOrder(self), Parent = self.Container,
    }, { create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) })

    local header = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        LayoutOrder = 1, Parent = holder,
    })
    local label = create("TextLabel", {
        Size = UDim2.new(1, -52, 1, 0), BackgroundTransparency = 1, Text = "", TextColor3 = Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Font, TextSize = 13, Parent = header,
    })
    loc(label, opts.Name or "Color")
    local swatch = create("Frame", {
        Size = UDim2.fromOffset(42, 20), Position = UDim2.new(1, 0, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5),
        BackgroundColor3 = color, Parent = header,
    }, { corner(7), stroke(WHITE, 1, 0.65) })

    local panel = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), BackgroundColor3 = Theme.Black, Visible = false, ClipsDescendants = true,
        LayoutOrder = 2, Parent = holder,
    }, { corner(9) })
    local pst = stroke(Theme.Stroke, 1, 0.2)
    pst.Parent = panel

    local bars, grads, knobs = {}, {}, {}
    local function makeBar(key, y, letter)
        local l = create("TextLabel", {
            Size = UDim2.fromOffset(14, 12), Position = UDim2.new(0, 8, 0, y), BackgroundTransparency = 1,
            Text = letter, TextColor3 = Theme.SubText, Font = Theme.FontBold, TextSize = 10, Parent = panel,
        })
        colorize(l, "TextColor3", "SubText")
        local bar = create("TextButton", {
            Size = UDim2.new(1, -44, 0, 12), Position = UDim2.new(0, 28, 0, y), BackgroundColor3 = WHITE,
            Text = "", AutoButtonColor = false, Parent = panel,
        }, { corner(6) })
        grads[key] = create("UIGradient", { Parent = bar })
        knobs[key] = create("Frame", {
            Size = UDim2.fromOffset(10, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            BackgroundColor3 = WHITE, Parent = bar,
        }, { corner(4), stroke(BLACK, 1, 0.4) })
        bars[key] = bar
    end
    makeBar("h", 10, "H")
    makeBar("s", 36, "S")
    makeBar("v", 62, "V")

    local hexBox = create("TextBox", {
        Size = UDim2.new(1, -16, 0, 24), Position = UDim2.new(0, 8, 0, 90), BackgroundColor3 = Theme.Element,
        Text = "", PlaceholderText = "#RRGGBB", TextColor3 = Theme.Text, PlaceholderColor3 = Theme.SubText,
        Font = Theme.Font, TextSize = 12, ClearTextOnFocus = false, Parent = panel,
    }, { corner(7) })

    local rainbow = {}
    for i = 0, 6 do table.insert(rainbow, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 0.999), 1, 1))) end
    grads.h.Color = ColorSequence.new(rainbow)

    local obj = {}
    local function refresh(silent)
        color = Color3.fromHSV(h, s, v)
        swatch.BackgroundColor3 = color
        grads.s.Color = ColorSequence.new(Color3.fromHSV(h, 0, v), Color3.fromHSV(h, 1, v))
        grads.v.Color = ColorSequence.new(BLACK, Color3.fromHSV(h, s, 1))
        knobs.h.Position = UDim2.new(h, 0, 0.5, 0)
        knobs.s.Position = UDim2.new(s, 0, 0.5, 0)
        knobs.v.Position = UDim2.new(v, 0, 0.5, 0)
        hexBox.Text = "#" .. color:ToHex():upper()
        if not silent then safe(opts.Callback, color) end
    end

    local active
    local function setFromX(which, x)
        local bar = bars[which]
        local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        if which == "h" then h = a elseif which == "s" then s = a else v = a end
        refresh()
    end
    for key, bar in pairs(bars) do
        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                active = key
                setFromX(key, input.Position.X)
            end
        end)
    end
    UserInputService.InputChanged:Connect(function(input)
        if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(active, input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            active = nil
        end
    end)
    hexBox.FocusLost:Connect(function()
        local txt = hexBox.Text:gsub("%s", "")
        local ok, c = pcall(Color3.fromHex, txt)
        if ok and c then
            h, s, v = c:ToHSV()
        end
        refresh()
    end)

    header.MouseButton1Click:Connect(function()
        open = not open
        if open then
            panel.Visible = true
            panel.Size = UDim2.new(1, 0, 0, 0)
            tween(panel, { Size = UDim2.new(1, 0, 0, PH) }, 0.25, Enum.EasingStyle.Quint)
        else
            tween(panel, { Size = UDim2.new(1, 0, 0, 0) }, 0.2).Completed:Once(function()
                if not open then panel.Visible = false end
            end)
        end
    end)

    bind(function()
        label.TextColor3 = Theme.SubText
        panel.BackgroundColor3, pst.Color = Theme.Black, Theme.Stroke
        hexBox.BackgroundColor3, hexBox.TextColor3, hexBox.PlaceholderColor3 = Theme.Element, Theme.Text, Theme.SubText
    end)

    function obj:Set(c, silent)
        h, s, v = c:ToHSV()
        refresh(silent)
    end
    function obj:Get() return color end

    refresh(true)
    return obj
end

