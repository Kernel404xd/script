        restrictedSpawnPart = bossFolder and bossFolder:FindFirstChild("Restricted Sorcerer", true)
        if not restrictedSpawnPart and bossFolder then
            for _, object in ipairs(bossFolder:GetDescendants()) do
                if normName(object.Name) == "restricted sorcerer" then
                    restrictedSpawnPart = object
                    break
                end
            end
        end
        if restrictedSpawnPart and restrictedSpawnPart:IsA("BasePart") then
