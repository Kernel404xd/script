    })

    function FruitFeature.findTargets()
        local dropped = FruitFeature.findDroppedTools()
        local targets = {}
        if not dropped then return targets, false end
        for _, obj in ipairs(dropped:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == "Handle" then
                local prompt = FruitFeature.getPrompt(obj)
                if prompt and prompt.Enabled then
                    table.insert(targets, { Handle = obj, Prompt = prompt })
                end
            end
        end
        return targets, true
    end

    function FruitFeature.snapshotTools()
        local snapshot = {}
        local player = Players.LocalPlayer
        local backpack = player and player:FindFirstChild("Backpack")
        local character = player and player.Character
        for _, container in ipairs({ backpack, character }) do
            if container then
                for _, child in ipairs(container:GetChildren()) do
                    if child:IsA("Tool") then snapshot[child] = true end
                end
            end
        end
        return snapshot
    end

    function FruitFeature.findFruitTool(fruitName, before)
        local player = Players.LocalPlayer
        local backpack = player and player:FindFirstChild("Backpack")
        local character = player and player.Character
        local candidate
        for _, container in ipairs({ backpack, character }) do
            if container then
                for _, child in ipairs(container:GetChildren()) do
                    if child:IsA("Tool") then
                        if before and not before[child] then return child end
                        local toolName = normName(child.Name)
                        local wanted = normName(fruitName)
                        if wanted ~= "" and (toolName:find(wanted, 1, true) or wanted:find(toolName, 1, true)) then
                            candidate = candidate or child
                        end
                    end
                end
            end
        end
        return candidate
    end

    function FruitFeature.withMenuHidden(callback)
        local wasVisible = Window:IsMenuVisible()
        if wasVisible then
            Window:SetMenuVisible(false)
            task.wait(0.08)
        end
        local ok, result = pcall(callback)
        if wasVisible then Window:SetMenuVisible(true) end
        return ok and result ~= false, result
    end

