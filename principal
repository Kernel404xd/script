-- Resolve o caminho do NPC com fallback sem diferenciar maiúsculas/minúsculas.
local function resolveNpcPath(path)
    local current = workspace
    for _, name in ipairs(path or {}) do
        local nextObj = current:FindFirstChild(name)
        if not nextObj then
            local wanted = string.lower(tostring(name))
            for _, child in ipairs(current:GetChildren()) do
                if string.lower(child.Name) == wanted then
                    nextObj = child
                    break
                end
            end
        end
        if not nextObj then
            log("NPC", string.format("caminho não encontrado em '%s' (dentro de %s)",
                tostring(name), current:GetFullName()), true)
            return nil
        end
        current = nextObj
    end
    return current
end

-- procura a NPC entre os Models carregados. Com cfg.Name definido, SÓ aceita esse nome
-- (nunca cai em outra NPC de quest). Devolve o Model + a posição, ou nil.
local function findNpcInWorld(cfg)
    cfg = cfg or QuestNpc
    local root = resolveNpcPath(cfg.Path)
    if not root then return nil end

    local models = listNpcModels(root, cfg.Name)
    local names = {}
    for _, m in ipairs(models) do table.insert(names, m.Name) end

    local pool = models
    if cfg.Name then
        pool = {}
        for _, m in ipairs(models) do
            if string.lower(m.Name) == string.lower(tostring(cfg.Name)) then table.insert(pool, m) end
        end
    end
    if #pool == 0 then
        log("NPC", string.format("'%s' não está carregada (NPCs carregados: %s)",
            tostring(cfg.Name), #names > 0 and table.concat(names, ", ") or "nenhum"), true)
        return nil
    end

    local char = Players.LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local best, bestPos, bestDist
    for _, m in ipairs(pool) do
        local pos = npcPosition(m)
        local dist = hrp and (hrp.Position - pos).Magnitude or 0
        if not bestDist or dist < bestDist then best, bestPos, bestDist = m, pos, dist end
    end

    log("NPC", string.format("alvo: %s a %.0f studs", best:GetFullName(), bestDist or 0))
    return best, bestPos
end

-- sem argumento = Mari (QuestNpc); com ZackQuest = Zack
local function findNpcTarget(cfg)
    local isDefault = (cfg == nil)
    cfg = cfg or QuestNpc
    local function setLast(p)
        if isDefault then npcLastPos = p else cfg.LastPos = p end
        rememberNpcPos(cfg.Name, p, cfg.Path)
    end

    local model, pos = findNpcInWorld(cfg)
    if model then
        setLast(pos)
        if Config.HideNpcLoadWarning then Config.HideNpcLoadWarning() end
        return model, pos
    end

    -- não carregada (longe do player, StreamingEnabled): vai até a última posição conhecida
    -- dela e espera ela carregar. NUNCA usa outra NPC no lugar.
    local lastPos = cfg.Position or recallNpcPos(cfg.Name, cfg.Path)
        or (isDefault and npcLastPos) or cfg.LastPos
    if lastPos and cfg.Name then
        log("NPC", string.format("indo até a última posição conhecida de %s para ela carregar", cfg.Name))
        if teleportTo(lastPos, 3) then
            pcall(function() Players.LocalPlayer:RequestStreamingAround(lastPos) end)
            local t = 0
            while t < 12 do
                task.wait(0.2)
                t += 0.2
                model, pos = findNpcInWorld(cfg)
                if model then
                    setLast(pos)
                    if Config.HideNpcLoadWarning then Config.HideNpcLoadWarning() end
                    return model, pos
                end
            end
        end
    elseif cfg.Name then
        log("NPC", string.format("nunca vi %s carregado: chegue perto dele(a) uma vez (ou defina a Position)",
            cfg.Name), true)
        if Config.ShowNpcLoadWarning then Config.ShowNpcLoadWarning(cfg.Name) end
    end
    return nil
end

