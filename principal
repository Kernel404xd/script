local function applyTabState(tab, active, animate)
    local goals = {
        bg   = active and 0.8 or 1,
        text = active and Theme.Text or Theme.SubText,
        bar  = active and 20 or 0,
    }
    tab.Button.BackgroundColor3 = Theme.Accent
    if animate then
        tween(tab.Button, { BackgroundTransparency = goals.bg, TextColor3 = goals.text })
        tween(tab.Bar, { Size = UDim2.new(0, 3, 0, goals.bar) }, 0.25, Enum.EasingStyle.Back)
    else
        tab.Button.BackgroundTransparency = goals.bg
        tab.Button.TextColor3 = goals.text
        tab.Bar.Size = UDim2.new(0, 3, 0, goals.bar)
    end
    tab.Bar.BackgroundColor3 = Theme.AccentLite
end

function Kernel404:CreateTab(name)
    local tab = setmetatable({ Window = self, Name = name }, Tab)

    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1,
        Text = "", TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
        Font = Theme.Font, TextSize = 13, AutoButtonColor = false,
        LayoutOrder = #self.Tabs + 1, Parent = self.TabList,
    }, { corner(9) })
    loc(button, name, "    ")
    local bar = create("Frame", {
        Size = UDim2.new(0, 3, 0, 0), Position = UDim2.new(0, 4, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = Theme.AccentLite, BorderSizePixel = 0, Parent = button,
    }, { corner(2) })

    local page = create("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent, AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(), Visible = false, Parent = self.Content,
    })
    colorize(page, "ScrollBarImageColor3", "Accent")

    -- Frame comum com padding (UIPadding direto no ScrollingFrame desalinhava as colunas)
    local inner = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = page,
    }, { padding(12) })
    local row = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = inner,
    })

    local function column(xScale, xOffset)
        return create("Frame", {
            Size = UDim2.new(0.5, -6, 0, 0), Position = UDim2.new(xScale, xOffset, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = row,
        }, { create("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }) })
    end
    tab.Left, tab.Right = column(0, 0), column(0.5, 6)
    tab.Button, tab.Bar, tab.Page = button, bar, page

    button.MouseButton1Click:Connect(function() self:SelectTab(tab) end)
    button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then tween(button, { BackgroundTransparency = 0.9 }) end
    end)
    button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then tween(button, { BackgroundTransparency = 1 }) end
    end)

    table.insert(self.Tabs, tab)
    bind(function() applyTabState(tab, self.ActiveTab == tab, false) end)
    if not self.ActiveTab then self:SelectTab(tab) end
    return tab
end

function Kernel404:SelectTab(tab)
    for _, t in ipairs(self.Tabs) do
        local active = (t == tab)
        t.Page.Visible = active
        applyTabState(t, active, true)
    end
    self.ActiveTab = tab
end

