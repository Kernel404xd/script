            log("Fruit", "toque de abertura ignorado por cooldown da mesma fruta")
            return false
        end
        local opened, detail = FruitFeature.withMenuHidden(function()
            local camera = workspace.CurrentCamera
            if not camera then error("CurrentCamera indisponível") end
            local point = camera.ViewportSize / 2
            local inset = GuiService:GetGuiInset()
            local x, y = point.X + inset.X, point.Y + inset.Y
            log("Fruit", string.format("enviando clique único central para abrir interface em (%.0f, %.0f)", x, y))
            -- Mesma sequência do sistema de ataque: mouse down, aguarda, mouse up.
            local input = game:GetService("VirtualInputManager")
            input:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.08)
            input:SendMouseButtonEvent(x, y, 0, false, game, 0)
            return true
        end)
        if opened and handle then FruitFeature.OpenTapCooldown[handle] = now + 8 end
        log("Fruit", "resultado toque de abertura: " .. tostring(opened) .. (detail and (" | " .. tostring(detail)) or ""), not opened)
