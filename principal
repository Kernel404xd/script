    }) })

    ------------------------------------------------------------------
    -- animações contínuas (borda girando, pulso da aura, arco-íris, FPS)
    ------------------------------------------------------------------
    local t0, frames, fpsClock = os.clock(), 0, os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not gui.Parent then conn:Disconnect() return end
        local t = os.clock() - t0
        borderGrad.Rotation = (t * 50) % 360
        local pulse = 1 + math.sin(t * 2) * 0.15
        local rainbowColor = Color3.fromHSV((t * 0.12) % 1, 0.7, 1)
        for i, l in ipairs(auraLayers) do
            local falloff = 1 - (i - 1) / AURA_N
            local alpha = Config.AuraIntensity * 0.14 * falloff * falloff * pulse
            l.BackgroundTransparency = 1 - math.clamp(alpha, 0, 1)
            if Config.AuraRainbow then l.BackgroundColor3 = rainbowColor end
        end
        frames += 1
        local now = os.clock()
        if now - fpsClock >= 0.5 then
            fpsLabel.Text = string.format("%d FPS", math.floor(frames / (now - fpsClock) + 0.5))
            frames, fpsClock = 0, now
        end
    end)

    ------------------------------------------------------------------
    -- arrastar / minimizar / fechar / tecla
    ------------------------------------------------------------------
    do
        local dragging, dragStart, startPos
        topbar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging, dragStart, startPos = true, input.Position, root.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then dragging = false end
                end)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - dragStart
                root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
    end

    local minimized = false
    local restoreBtn = create("TextButton", {
        Size = UDim2.new(1, -48, 1, 0), Position = UDim2.fromOffset(0, 0),
        BackgroundTransparency = 1, Text = "", TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
        Font = Theme.FontBold, TextSize = 16, Visible = false, ZIndex = 10, Parent = topbar,
    })
    local miniDragging, miniDragStart, miniStartPos, miniDragged = false, nil, nil, false
    restoreBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            miniDragging, miniDragged = true, false
            miniDragStart, miniStartPos = input.Position, root.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then miniDragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if miniDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - miniDragStart
            if delta.Magnitude > 3 then miniDragged = true end
            root.Position = UDim2.new(
                miniStartPos.X.Scale, miniStartPos.X.Offset + delta.X,
                miniStartPos.Y.Scale, miniStartPos.Y.Offset + delta.Y
            )
        end
    end)

    local function setMinimized(value)
        minimized = value
        sidebar.Visible = not minimized
        content.Visible = not minimized
        nameG.Holder.Visible = true
        fpsLabel.Visible = not minimized
        versionPill.Visible = not minimized
        minBtn.Visible = true
        minBtn.Text = minimized and "+" or "–"
        minBtn.Position = minimized and UDim2.new(1, -38, 0.5, -14) or UDim2.new(1, -70, 0.5, -14)
        closeBtn.Visible = not minimized
        restoreBtn.Visible = minimized
        autoClickPausedByPanel = root.Visible and not minimized
        tween(root, {
            Size = minimized and UDim2.fromOffset(170, BAR_H) or UDim2.fromOffset(WIN_W, WIN_H),
        }, 0.28, Enum.EasingStyle.Quint)
    end
    minBtn.MouseButton1Click:Connect(function()
        setMinimized(not minimized)
    end)
    restoreBtn.MouseButton1Click:Connect(function()
        if minimized and not miniDragged then setMinimized(false) end
    end)
    closeBtn.MouseButton1Click:Connect(function()
        autoClickPausedByPanel = false
        tween(openScale, { Scale = 0.85 }, 0.2)
        task.delay(0.2, function() gui:Destroy() end)
    end)
    UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Config.ToggleKey then
            root.Visible = not root.Visible
            autoClickPausedByPanel = root.Visible and not minimized
            if root.Visible then
                openScale.Scale = 0.9
                tween(openScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
            end
        end
    end)

    -- mostra/esconde a janela por código (usado pelos farms: menu some ao ligar, volta ao desligar)
    function self:SetMenuVisible(v)
        if root.Visible == v then return end
        root.Visible = v
        autoClickPausedByPanel = v and not minimized
        if v then
            openScale.Scale = 0.9
            tween(openScale, { Scale = 1 }, 0.3, Enum.EasingStyle.Back)
        end
    end
    function self:IsMenuVisible() return root.Visible end

    applyTheme()
    return self
end

