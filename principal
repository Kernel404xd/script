        Name = "Reset defaults",
        Callback = function()
            restore(Defaults)
            for key, w in pairs(widgets.pickers) do w:Set(Config.Colors[key], true) end
            widgets.intensity:Set(Config.AuraIntensity * 100, true)
            widgets.transp:Set(Config.Transparency * 100, true)
            widgets.rainbow:Set(Config.AuraRainbow, true)
            widgets.particles:Set(Config.Particles, true)
            widgets.debug:Set(Config.Debug, true)
            renderPositionPreview()
            if applyActiveFarmPanelPositions then applyActiveFarmPanelPositions() end
