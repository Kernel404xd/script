function Kernel404:CreateConfigTab()
    local tab = self:CreateTab("Config")
    local widgets = {}

    local function changed()
        applyTheme()
        scheduleSave()
    end
    local function colorCb(key)
        return function(c)
            Config.Colors[key] = c
            changed()
        end
    end

    -- ESQUERDA: tema + cores
    local themeSec = tab:CreateSection("Theme", "Left")
    local names = {}
    for _, p in ipairs(ThemePresets) do table.insert(names, p.Name) end
    widgets.preset = themeSec:AddDropdown({
        Name = "Theme preset", Options = names, Default = "Violet",
        Callback = function(name)
            for _, p in ipairs(ThemePresets) do
                if p.Name == name then
                    Config.Colors.Accent, Config.Colors.Aura = p.Accent, p.Accent
                    Config.Colors.Background, Config.Colors.Panel, Config.Colors.Text = p.Background, p.Panel, p.Text
                    for key, w in pairs(widgets.pickers) do w:Set(Config.Colors[key], true) end
                    changed()
                end
            end
        end,
    })

    local colorSec = tab:CreateSection("Colors", "Left")
    widgets.pickers = {}
    local function addPicker(sec, key, label)
        widgets.pickers[key] = sec:AddColorPicker({ Name = label, Default = Config.Colors[key], Callback = colorCb(key) })
    end
    addPicker(colorSec, "Accent", "Main color")
    addPicker(colorSec, "Background", "Background")
    addPicker(colorSec, "Panel", "Panels")
    addPicker(colorSec, "Text", "Text")
    colorSec:AddLabel("Quick colors")
    colorSec:AddColorPresets({
        Callback = function(c)
            Config.Colors.Accent = c
            widgets.pickers.Accent:Set(c, true)
            changed()
        end,
    })

    -- DIREITA: aura + janela + idioma
    local auraSec = tab:CreateSection("Aura", "Right")
    addPicker(auraSec, "Aura", "Aura color")
    widgets.intensity = auraSec:AddSlider({
        Name = "Aura intensity", Min = 0, Max = 100, Default = math.floor(Config.AuraIntensity * 100 + 0.5),
        Callback = function(val) Config.AuraIntensity = val / 100; scheduleSave() end,
    })
    widgets.rainbow = auraSec:AddToggle({
        Name = "Rainbow aura", Default = Config.AuraRainbow,
        Callback = function(on) Config.AuraRainbow = on; changed() end,
    })

    local winSec = tab:CreateSection("Window", "Right")
    widgets.transp = winSec:AddSlider({
        Name = "Transparency", Min = 0, Max = 60, Default = math.floor(Config.Transparency * 100 + 0.5),
        Callback = function(val) Config.Transparency = val / 100; changed() end,
    })
    widgets.particles = winSec:AddToggle({
        Name = "Particles", Default = Config.Particles,
        Callback = function(on) Config.Particles = on; changed() end,
    })
    widgets.debug = winSec:AddToggle({
        Name = "Debug prints", Default = Config.Debug,
        Callback = function(on) Config.Debug = on; scheduleSave() end,
    })

    local posSec = tab:CreateSection("Farm Panel Position", "Right")
    posSec:AddLabel("Click one of the 8 positions to move active panels. HERE marks the selected position.")
    local positionPreview = create("Frame", {
        Name = "FarmPanelPositionPreview",
        Size = UDim2.new(1, 0, 0, 154),
        BackgroundColor3 = Color3.fromRGB(12, 12, 14),
        BorderSizePixel = 0,
        LayoutOrder = 20,
        Parent = posSec.Container,
    }, { corner(12), stroke(Theme.Stroke, 1, 0.15) })
    local previewStroke = positionPreview:FindFirstChildOfClass("UIStroke")
    if previewStroke then previewStroke.Color = Theme.Stroke end
    local positionCells = {
        { Key = "TopLeft", X = 0, Y = 0 },
        { Key = "TopCenter", X = 0.5, Y = 0 },
        { Key = "TopRight", X = 1, Y = 0 },
        { Key = "MiddleLeft", X = 0, Y = 0.5 },
        { Key = "MiddleRight", X = 1, Y = 0.5 },
        { Key = "BottomLeft", X = 0, Y = 1 },
        { Key = "BottomCenter", X = 0.5, Y = 1 },
        { Key = "BottomRight", X = 1, Y = 1 },
    }
