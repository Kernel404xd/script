        end,
    })

    function PlayerFeatures.restoreCollision()
        for part, original in pairs(PlayerFeatures.NoclipOriginal) do
            if part and part.Parent then pcall(function() part.CanCollide = original end) end
            PlayerFeatures.NoclipOriginal[part] = nil
        end
    end

